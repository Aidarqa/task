<MudTextField T="string"
              Value="@TimeToString()"
              ValueChanged="@OnValueChanged"
              InputType="InputType.Time"
              Label="@Label"
              Variant="Variant.Outlined"
              Margin="@Margin"
              Disabled="@Disabled"
              Clearable="@Clearable"
              OnClearButtonClick="@OnClear" />

@code {
    [Parameter] public TimeSpan? Time { get; set; }
    [Parameter] public EventCallback<TimeSpan?> TimeChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public Margin Margin { get; set; } = Margin.None;

    private string TimeToString()
        => Time.HasValue ? $"{Time.Value.Hours:D2}:{Time.Value.Minutes:D2}" : "";

    private async Task OnValueChanged(string? value)
    {
        if (string.IsNullOrEmpty(value))
            await TimeChanged.InvokeAsync(null);
        else if (TimeSpan.TryParseExact(value, "hh\\:mm",
                     System.Globalization.CultureInfo.InvariantCulture, out var ts))
            await TimeChanged.InvokeAsync(ts);
    }

    private async Task OnClear()
        => await TimeChanged.InvokeAsync(null);
}
