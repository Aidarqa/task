@inject IAuthService AuthSvc
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:380px">
            <MudTextField @bind-Value="_current" Label="Текущий пароль"
                          Required="true"
                          InputType="@(_showCurrent ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showCurrent ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showCurrent = !_showCurrent" />

            <MudTextField @bind-Value="_newPassword" Label="Новый пароль (минимум 6 символов)"
                          Required="true"
                          InputType="@(_showNew ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showNew ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showNew = !_showNew" />

            <MudTextField @bind-Value="_confirm" Label="Повторите новый пароль"
                          Required="true"
                          InputType="@(_showConfirm ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showConfirm ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showConfirm = !_showConfirm" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync" Disabled="_busy">Сменить пароль</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    private string _current = "";
    private string _newPassword = "";
    private string _confirm = "";
    private string? _error;
    private bool _busy;
    private bool _showCurrent;
    private bool _showNew;
    private bool _showConfirm;

    private async Task SaveAsync()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_current) ||
            string.IsNullOrWhiteSpace(_newPassword) ||
            string.IsNullOrWhiteSpace(_confirm))
        {
            _error = "Заполните все поля";
            return;
        }
        if (_newPassword.Length < 6)
        {
            _error = "Новый пароль должен быть минимум 6 символов";
            return;
        }
        if (_newPassword != _confirm)
        {
            _error = "Новый пароль и подтверждение не совпадают";
            return;
        }
        if (_newPassword == _current)
        {
            _error = "Новый пароль должен отличаться от текущего";
            return;
        }

        _busy = true;
        try
        {
            var resp = await AuthSvc.ChangePasswordAsync(new ChangePasswordRequest(_current, _newPassword));
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Пароль изменён", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                _error = await ExtractErrorAsync(resp);
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private static async Task<string> ExtractErrorAsync(HttpResponseMessage resp)
    {
        try
        {
            var json = await resp.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            if (json is not null && json.TryGetValue("error", out var msg)) return msg;
        }
        catch { }
        return resp.StatusCode switch
        {
            System.Net.HttpStatusCode.Unauthorized => "Сессия истекла, войдите снова",
            System.Net.HttpStatusCode.BadRequest   => "Текущий пароль неверный",
            _ => $"Ошибка: {(int)resp.StatusCode}"
        };
    }
}
