@inherits LocalizedLayoutBase
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject NotificationClientService NotificationSvc
@inject ThemeService ThemeSvc
@inject Blazored.LocalStorage.ILocalStorageService Storage
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudLayout>
    <MudAppBar Elevation="0" Dense="true" Class="app-topbar">
        <MudIconButton Icon="@Icons.Material.Outlined.Menu"
                       OnClick="ToggleDrawer" />
        <MudText Typo="Typo.h6" Class="ml-2 app-logo">@L["app_name"]</MudText>
        <MudSpacer />

        <MudButtonGroup Size="Size.Small" Variant="Variant.Outlined" Class="mr-2 lang-switcher">
            <MudButton OnClick='@(() => SetLang("ru"))'
                       Color="@(L.Lang == "ru" ? Color.Primary : Color.Default)">@L["settings_lang_ru"]</MudButton>
            <MudButton OnClick='@(() => SetLang("ky"))'
                       Color="@(L.Lang == "ky" ? Color.Primary : Color.Default)">@L["settings_lang_ky"]</MudButton>
        </MudButtonGroup>

        <MudIconButton Icon="@(ThemeSvc.IsDark ? Icons.Material.Outlined.LightMode : Icons.Material.Outlined.DarkMode)"
                       OnClick="ToggleTheme" Size="Size.Small" Class="mr-1" />

        <AuthorizeView>
            <Authorized>
                @if (_systemUnreadCount > 0)
                {
                    <MudTooltip Text="@($"{_systemUnreadCount} системных уведомлений")" Placement="Placement.Bottom">
                        <MudBadge Content="@_systemUnreadCount" Color="Color.Warning"
                                  Overlap="true" Visible="true">
                            <MudIconButton Icon="@Icons.Material.Filled.Campaign"
                                           Size="Size.Small"
                                           Color="Color.Warning"
                                           OnClick="@(() => Nav.NavigateTo("/notifications"))" />
                        </MudBadge>
                    </MudTooltip>
                }

                <MudMenu AnchorOrigin="Origin.BottomRight"
                         TransformOrigin="Origin.TopRight"
                         Dense="true">
                    <ActivatorContent>
                        <MudBadge Content="@NonChatUnreadCount" Color="Color.Error" Dot
                                  Overlap="true" Visible="@(NonChatUnreadCount > 0)">
                            <MudIconButton Icon="@Icons.Material.Outlined.Notifications"
                                           Size="Size.Small" />
                        </MudBadge>
                    </ActivatorContent>
                    <ChildContent>
                        <div class="notif-dropdown">
                            <div class="notif-dropdown-header">
                                <span>@L["notif_title"]</span>
                                @if (NonChatUnreadCount > 0)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Error">
                                        @NonChatUnreadCount
                                    </MudChip>
                                }
                            </div>
                            <MudDivider />

                            @if (_recentNotifications.Count == 0)
                            {
                                <div class="notif-dropdown-empty">@L["notif_no_recent"]</div>
                            }
                            else
                            {
                                @foreach (var n in _recentNotifications.Take(5))
                                {
                                    <MudMenuItem OnClick="@(() => OpenNotification(n))">
                                        <div class="notif-dropdown-item">
                                            <div class="notif-dropdown-icon"
                                                 style="@($"--notif-color:{GetNotifColor(n.NotificationType)}")">
                                                <MudIcon Icon="@GetNotifIcon(n.NotificationType)" Size="Size.Small" />
                                            </div>
                                            <div style="min-width:0">
                                                <div class="notif-dropdown-title @(n.IsRead ? "" : "notif-dropdown-title--unread")">
                                                    @n.Title
                                                </div>
                                                @if (n.Body is not null)
                                                {
                                                    <div class="notif-dropdown-body">@n.Body</div>
                                                }
                                                <div class="notif-dropdown-meta">
                                                    <span class="notif-dropdown-type">
                                                        @GetNotifTypeName(n.NotificationType)
                                                    </span>
                                                    <span>
                                                        @KyrgyzstanTime.FormatDateTime(n.CreatedAt)
                                                    </span>
                                                </div>
                                            </div>
                                        </div>
                                    </MudMenuItem>
                                }
                            }

                            <MudDivider />
                            <MudMenuItem OnClick="@(() => Nav.NavigateTo("/notifications"))">
                                <div class="d-flex align-center" style="gap:.35rem;">
                                    <MudText Typo="Typo.body2" Color="Color.Primary">
                                        @L["notif_view_all"]
                                    </MudText>
                                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Primary" />
                                </div>
                            </MudMenuItem>
                        </div>
                    </ChildContent>
                </MudMenu>

                <MudText Typo="Typo.body2" Class="mx-2 d-none d-sm-flex user-name-text">
                    @context.User.Identity?.Name
                </MudText>
                <MudIconButton Icon="@Icons.Material.Outlined.Logout"
                               OnClick="HandleLogout" Size="Size.Small" />
            </Authorized>
        </AuthorizeView>
    </MudAppBar>

    <AuthorizeView>
        <Authorized>
            <MudDrawer @bind-Open="_drawerOpen"
                       Elevation="0"
                       Variant="@DrawerVariant.Responsive"
                       ClipMode="DrawerClipMode.Always"
                       Class="sidebar-drawer">
                <MudNavMenu Class="sidebar-nav">
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Class="nav-dashboard"
                                Icon="@Icons.Material.Outlined.Dashboard">@L["nav_home"]</MudNavLink>
                    <MudNavLink Href="/dashboard" Match="NavLinkMatch.Prefix" Class="nav-home"
                                Icon="@Icons.Material.Outlined.BarChart">@L["nav_dashboard"]</MudNavLink>

                    <MudText Typo="Typo.overline" Class="sidebar-section-label">@L["nav_sec_tasks"]</MudText>
                    <MudNavLink Href="/projects" Match="NavLinkMatch.Prefix" Class="nav-projects"
                                Icon="@Icons.Material.Outlined.FolderOpen">@L["nav_projects"]</MudNavLink>
                    <MudNavLink Href="/tasks" Match="NavLinkMatch.Prefix" Class="nav-tasks"
                                Icon="@Icons.Material.Outlined.Assignment">@L["nav_tasks"]</MudNavLink>
                    <MudNavLink Href="/todo" Match="NavLinkMatch.Prefix" Class="nav-todo"
                                Icon="@Icons.Material.Outlined.CheckCircle">@L["nav_todo"]</MudNavLink>

                    <MudText Typo="Typo.overline" Class="sidebar-section-label">@L["nav_sec_planning"]</MudText>
                    <MudNavLink Href="/calendar" Match="NavLinkMatch.Prefix" Class="nav-calendar"
                                Icon="@Icons.Material.Outlined.CalendarMonth">@L["nav_calendar"]</MudNavLink>
                    <MudNavLink Href="/bookings" Match="NavLinkMatch.Prefix" Class="nav-bookings"
                                Icon="@Icons.Material.Outlined.MeetingRoom">@L["nav_bookings"]</MudNavLink>
                    <MudNavLink Href="/visits" Match="NavLinkMatch.Prefix" Class="nav-visits-page"
                                Icon="@Icons.Material.Outlined.Badge">@L["nav_visits"]</MudNavLink>

                    <MudText Typo="Typo.overline" Class="sidebar-section-label">@L["nav_sec_comm"]</MudText>
                    <MudNavLink Href="/chats" Match="NavLinkMatch.Prefix" Class="nav-chats"
                                Icon="@Icons.Material.Outlined.Chat">
                        @L["nav_chats"]
                        @if (_chatUnreadCount > 0 && !Nav.Uri.Contains("/chats"))
                        {
                            <MudBadge Content="@_chatUnreadCount" Color="Color.Error" Class="ml-2" />
                        }
                    </MudNavLink>
                    <MudNavLink Href="/notifications" Match="NavLinkMatch.Prefix" Class="nav-notifications"
                                Icon="@Icons.Material.Outlined.Notifications">
                        @L["nav_notifications"]
                        @if (NonChatUnreadCount > 0)
                        {
                            <MudBadge Content="@NonChatUnreadCount" Color="Color.Error" Class="ml-2" />
                        }
                    </MudNavLink>

                    <MudText Typo="Typo.overline" Class="sidebar-section-label">@L["nav_sec_company"]</MudText>
                    <MudNavLink Href="/employees" Match="NavLinkMatch.Prefix" Class="nav-employees"
                                Icon="@Icons.Material.Outlined.People">@L["nav_employees"]</MudNavLink>

                    <AuthorizeView Policy="@TrelloClone.Shared.Models.Permissions.AdminAccess" Context="_admin">
                        <MudText Typo="Typo.overline" Class="sidebar-section-label">Администрирование</MudText>
                        <MudNavLink Href="/admin/users" Match="NavLinkMatch.Prefix"
                                    Icon="@Icons.Material.Outlined.ManageAccounts">Пользователи</MudNavLink>
                        <MudNavLink Href="/admin/roles" Match="NavLinkMatch.Prefix"
                                    Icon="@Icons.Material.Outlined.AdminPanelSettings">Роли и права</MudNavLink>
                        <MudNavLink Href="/admin/notifications" Match="NavLinkMatch.Prefix"
                                    Icon="@Icons.Material.Outlined.Campaign">Рассылка уведомлений</MudNavLink>
                    </AuthorizeView>

                    <div class="sidebar-bottom">
                        <MudNavLink Href="/help" Match="NavLinkMatch.Prefix" Class="nav-help"
                                    Icon="@Icons.Material.Outlined.MenuBook">@L["nav_help"]</MudNavLink>
                        <MudNavLink Href="/settings" Match="NavLinkMatch.Prefix" Class="nav-settings"
                                    Icon="@Icons.Material.Outlined.Settings">@L["nav_settings"]</MudNavLink>
                    </div>
                </MudNavMenu>
            </MudDrawer>
        </Authorized>
    </AuthorizeView>

    <MudMainContent Class="main-content-area">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;
    private int _unreadCount;
    private int _chatUnreadCount;
    private int _systemUnreadCount;
    private int NonChatUnreadCount => Math.Max(0, _unreadCount - _chatUnreadCount);
    private List<NotificationDto> _recentNotifications = [];
    private readonly HashSet<Guid> _handledNotificationIds = [];
    private readonly Queue<Guid> _handledIdQueue = new();
    private DotNetObjectReference<MainLayout>? _dotNetRef;

    protected override async Task OnInitializedAsync()
    {
        ThemeSvc.Changed += OnThemeChanged;
        NotificationSvc.OnNotification += OnNotificationReceived;
        NotificationSvc.OnCountChanged += OnCountChangedHandler;
        NotificationSvc.OnReconnected += OnHubReconnected;
        Nav.LocationChanged += OnLocationChanged;

        try
        {
            var lang = await Storage.GetItemAsStringAsync("lang");
            if (!string.IsNullOrEmpty(lang))
                L.Set(lang.Trim('"'));

            var dark = await Storage.GetItemAsync<bool?>("darkMode");
            if (dark.HasValue)
                ThemeSvc.Set(dark.Value);

            await NotificationSvc.ConnectAsync();
            _ = JS.InvokeAsync<string>("browserNotif.requestPermission");
            _unreadCount = await NotificationSvc.GetUnreadCountAsync();
            _chatUnreadCount = await NotificationSvc.GetChatUnreadCountAsync();
            _systemUnreadCount = await NotificationSvc.GetSystemUnreadCountAsync();
            _recentNotifications = (await NotificationSvc.GetAllAsync())
                .Where(n => n.NotificationType != NotificationType.Chat)
                .Take(5)
                .ToList();

            foreach (var notification in _recentNotifications)
                _handledNotificationIds.Add(notification.Id);
        }
        catch { }
    }

    private void OnNotificationReceived(NotificationDto notif)
    {
        if (!_handledNotificationIds.Add(notif.Id))
            return;
        // Bounded FIFO — evict oldest ID when set grows too large
        _handledIdQueue.Enqueue(notif.Id);
        if (_handledIdQueue.Count > 500)
            _handledNotificationIds.Remove(_handledIdQueue.Dequeue());

        if (notif.NotificationType == NotificationType.Chat)
        {
            if (!Nav.Uri.Contains("/chats", StringComparison.OrdinalIgnoreCase))
            {
                _unreadCount++;
                _chatUnreadCount++;
            }
            else
            {
                _ = RefreshCountsAsync();
            }

            // Always call show — JS decides based on document.visibilityState.
            // This covers the case where the user is on /chats but the browser
            // is minimized or focus is in another window.
            _ = JS.InvokeVoidAsync("browserNotif.show",
                notif.Title,
                notif.Body,
                notif.Link ?? "/chats",
                $"chat-{notif.RelatedEntityId}");

            _ = InvokeAsync(StateHasChanged);
            return;
        }

        _unreadCount++;

        _recentNotifications.Insert(0, notif);
        if (_recentNotifications.Count > 5)
            _recentNotifications.RemoveAt(5);

        var msg = notif.Body is not null ? $"{notif.Title}: {notif.Body}" : notif.Title;
        Snackbar.Add(msg, Severity.Info);

        // Browser notification — JS decides whether to show based on document.visibilityState
        var notifUrl = BuildNotificationUrl(notif);
        _ = JS.InvokeVoidAsync("browserNotif.show",
            notif.Title,
            notif.Body,
            notifUrl,
            $"notif-{notif.Id}");

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnCountChangedHandler()
    {
        _ = RefreshCountsAsync();
    }

    // Called when SignalR reconnects after a drop — re-fetch and show any missed notifications
    private void OnHubReconnected()
    {
        _ = ProcessMissedNotificationsAsync();
    }

    private async Task ProcessMissedNotificationsAsync()
    {
        try
        {
            var unread = await NotificationSvc.GetAllAsync(unreadOnly: true);
            foreach (var notif in unread)
            {
                // Only process ones we haven't already handled in this session
                if (!_handledNotificationIds.Contains(notif.Id))
                    OnNotificationReceived(notif);
            }
        }
        catch { }
    }

    private async Task RefreshCountsAsync()
    {
        try
        {
            _unreadCount = await NotificationSvc.GetUnreadCountAsync();
            _chatUnreadCount = await NotificationSvc.GetChatUnreadCountAsync();
            _systemUnreadCount = await NotificationSvc.GetSystemUnreadCountAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private static string BuildNotificationUrl(NotificationDto notif) =>
        (notif.NotificationType, notif.RelatedEntityId) switch
        {
            (NotificationType.Event,   { } id) => $"/calendar?eventId={id}",
            (NotificationType.Booking, { } id) => $"/bookings?bookingId={id}",
            (NotificationType.System,  { } id) => $"/projects?projectId={id}",
            _ => notif.Link ?? "/notifications"
        };

    private void OpenNotification(NotificationDto notif)
    {
        if (!notif.IsRead)
        {
            var idx = _recentNotifications.FindIndex(n => n.Id == notif.Id);
            if (idx >= 0)
                _recentNotifications[idx] = notif with { IsRead = true };

            _ = NotificationSvc.MarkReadAsync(notif.Id);
        }

        Nav.NavigateTo(BuildNotificationUrl(notif));
    }

    private string GetNotifTypeName(NotificationType t) => t switch
    {
        NotificationType.Task => L["notif_type_task"],
        NotificationType.Event => L["notif_type_event"],
        NotificationType.Booking => L["notif_type_booking"],
        NotificationType.Chat => L["notif_type_chat"],
        NotificationType.System => L["notif_type_system"],
        _ => L["notif_type_system"],
    };

    private static string GetNotifIcon(NotificationType t) => t switch
    {
        NotificationType.Task => Icons.Material.Filled.Assignment,
        NotificationType.Event => Icons.Material.Filled.Event,
        NotificationType.Booking => Icons.Material.Filled.MeetingRoom,
        NotificationType.Chat => Icons.Material.Filled.Chat,
        NotificationType.System => Icons.Material.Filled.Campaign,
        _ => Icons.Material.Filled.Info,
    };

    private static string GetNotifColor(NotificationType t) => t switch
    {
        NotificationType.Task => "#F59E0B",
        NotificationType.Event => "#3B82F6",
        NotificationType.Booking => "#10B981",
        NotificationType.Chat => "#8B5CF6",
        NotificationType.System => "#6366F1",
        _ => "#6B7280",
    };

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = RefreshCountsAsync();
        _ = EnsureHubConnectedAsync();
    }

    private async Task EnsureHubConnectedAsync()
    {
        try
        {
            await NotificationSvc.ConnectAsync();
            // If we just reconnected, refresh counts which may have been unavailable before
            _unreadCount = await NotificationSvc.GetUnreadCountAsync();
            _chatUnreadCount = await NotificationSvc.GetChatUnreadCountAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("browserNotif.setDotnetRef", _dotNetRef);
        }
    }

    /// <summary>Called from JS when the user clicks a browser notification.</summary>
    [JSInvokable]
    public void HandleNotificationClick(string? url)
    {
        if (!string.IsNullOrEmpty(url))
            Nav.NavigateTo(url, forceLoad: false);
    }

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public override void Dispose()
    {
        _dotNetRef?.Dispose();
        ThemeSvc.Changed -= OnThemeChanged;
        NotificationSvc.OnNotification -= OnNotificationReceived;
        NotificationSvc.OnCountChanged -= OnCountChangedHandler;
        NotificationSvc.OnReconnected -= OnHubReconnected;
        Nav.LocationChanged -= OnLocationChanged;
        base.Dispose();
    }

    private async Task SetLang(string lang)
    {
        L.Set(lang);
        await Storage.SetItemAsStringAsync("lang", lang);
    }

    private async Task ToggleTheme()
    {
        ThemeSvc.Toggle();
        await Storage.SetItemAsync("darkMode", ThemeSvc.IsDark);
    }

    private async Task HandleLogout()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }
}
