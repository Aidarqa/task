    private async Task AddChecklistAsync()
    {
        if (_selectedTask is null || string.IsNullOrWhiteSpace(_newChecklistText))
            return;

        var item = await TaskSvc.AddChecklistItemAsync(_selectedTask.Id, _newChecklistText.Trim());
        if (item is not null)
        {
            _selectedTask.Checklist.Add(item);
            _newChecklistText = string.Empty;
            await LoadTasksAsync();
        }
