@page "/tasks"
@page "/tasks/{TaskId:guid}"
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inherits LocalizedBase
@inject WorkTaskService TaskSvc
@inject EmployeeService EmployeeSvc
@inject ProjectService ProjectSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthState
@inject FileDownloadService FileDownloader

<PageTitle>@L["tasks_title"] - @L["app_name"]</PageTitle>

<MudStack Spacing="3" Class="tasks-shell">
    <MudPaper Class="tasks-toolbar" Elevation="0">
        <div class="tasks-toolbar__left">
            <div>
                <div class="tasks-title-row">
                    <MudText Typo="Typo.h4" Class="tasks-page-title">@L["tasks_title"]</MudText>
                    <MudTooltip Text="@GetTaskContextText()">
                        <MudIconButton Icon="@Icons.Material.Filled.Info"
                                       Size="Size.Small"
                                       Color="@GetTaskContextIconColor()"
                                       Class="tasks-context-icon" />
                    </MudTooltip>
                </div>
                <MudText Typo="Typo.body2" Class="tasks-page-subtitle">
                    @L["tasks_subtitle"]
                </MudText>

                @if (_currentProject is not null)
                {
                    <div class="tasks-project-context">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info"
                                 Variant="Variant.Outlined" Class="task-project-chip">
                            @($"{L["tasks_project"]}: {_currentProject.Name}")
                        </MudChip>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="ClearProjectFilter">
                            @L["tasks_without_project"]
                        </MudButton>
                    </div>
                }
                @if (_authorOnly)
                {
                    <div class="tasks-project-context">
                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary"
                                 Variant="Variant.Outlined" Class="task-project-chip">
                            Мои задачи
                        </MudChip>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="@(() => { _authorOnly = false; _ = LoadTasksAsync(); })">
                            Сбросить
                        </MudButton>
                    </div>
                }
                @if (_overdueOnly)
                {
                    <div class="tasks-project-context">
                        <MudChip T="string" Size="Size.Small" Color="Color.Error"
                                 Variant="Variant.Outlined" Class="task-project-chip">
                            Просроченные задачи
                        </MudChip>
                        <MudButton Variant="Variant.Text" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Clear"
                                   OnClick="@(() => { _overdueOnly = false; _ = LoadTasksAsync(); })">
                            Сбросить
                        </MudButton>
                    </div>
                }
                @* else if (IsWithoutProjectMode)
                {
                    <div class="tasks-project-context">
                        <MudChip T="string"
                                 Size="Size.Small"
                                 Color="Color.Default"
                                 Variant="Variant.Outlined"
                                 Class="task-project-chip">
                            @L["tasks_without_project"]
                        </MudChip>
                    </div>
                } *@
            </div>
        </div>

        <div class="tasks-toolbar__right">
            <MudToggleGroup T="string" @bind-Value="_view" Size="Size.Small" Class="tasks-view-toggle">
                <MudToggleItem Value="@("list")" title="Список">
                    <MudIcon Icon="@Icons.Material.Filled.ViewList" />
                </MudToggleItem>
                <MudToggleItem Value="@("board")" title="Доска">
                    <MudIcon Icon="@Icons.Material.Filled.ViewColumn" />
                </MudToggleItem>
            </MudToggleGroup>

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreateDialog">
                @L["tasks_new"]
            </MudButton>
        </div>
    </MudPaper>

    <MudPaper Class="tasks-filter-panel" Elevation="0">
        <MudStack AlignItems="AlignItems.Center" Row Justify="Justify.FlexEnd" Class="tasks-filter-row">
                <MudTextField T="string"
                              Value="_searchText"
                              ValueChanged="OnSearchTextChanged"
                              Label="Поиск"
                              Margin="Margin.Dense"
                              Variant="Variant.Outlined"
                              Clearable="true"
                              Immediate="true"
                              DebounceInterval="250"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search" />

                <MudSelect T="string"
                           Value="_projectFilterValue"
                           ValueChanged="OnProjectFilterChangedAsync"
                           Label="@L["tasks_filter_project"]"
                           Dense="true"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           ToStringFunc="FormatProjectSelectValue">
                    <MudSelectItem T="string" Value="@ProjectFilterAll">@L["tasks_all_tasks"]</MudSelectItem>
                    <MudSelectItem T="string" Value="@ProjectFilterNone">@L["tasks_without_project"]</MudSelectItem>
                    @foreach (var project in _projects.OrderBy(p => p.Name))
                    {
                        <MudSelectItem T="string" Value="@project.Id.ToString()">@project.Name</MudSelectItem>
                    }
                </MudSelect>

                <MudSelect T="string"
                           Value="_filterStatus"
                           ValueChanged="OnStatusFilterChangedAsync"
                           Label="@L["tasks_filter_status"]"
                           Dense="true"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Clearable="true">
                    <MudSelectItem Value="@("New")">@L["status_new"]</MudSelectItem>
                    <MudSelectItem Value="@("InProgress")">@L["status_inprogress"]</MudSelectItem>
                    <MudSelectItem Value="@("Review")">@L["status_review"]</MudSelectItem>
                    <MudSelectItem Value="@("Done")">@L["status_done"]</MudSelectItem>
                </MudSelect>

                <MudCheckBox T="bool"
                             Value="_myOnly"
                             ValueChanged="OnMyOnlyChangedAsync"
                             Label="@L["tasks_my_assigned_only"]"
                             Color="Color.Primary" />
        </MudStack>
    </MudPaper>

    <MudGrid Class="tasks-content-grid">
        <MudItem xs="12" Class="tasks-column">
            <div class="tasks-list-shell">
                <div class="tasks-scroll-panel tasks-list-scroll">
                    @if (_loading)
                    {
                        <MudPaper Class="pa-6 d-flex flex-column align-center justify-center" Elevation="0">
                            <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                            <MudText Typo="Typo.body1" Class="mt-3">@L["tasks_loading"]</MudText>
                        </MudPaper>
                    }
                    else if (_tasks.Count == 0)
                    {
                        <MudPaper Class="pa-6 d-flex flex-column align-center justify-center" Elevation="0">
                            <MudIcon Icon="@Icons.Material.Filled.Assignment" Size="Size.Large" />
                            <MudText Typo="Typo.h6" Class="mt-3">@L["tasks_empty_filtered"]</MudText>
                            @if (_currentProject is not null)
                            {
                                <MudText Typo="Typo.body2" Class="mt-1">@string.Format(L["tasks_empty_project"], _currentProject.Name)</MudText>
                            }
                            else if (IsWithoutProjectMode)
                            {
                                <MudText Typo="Typo.body2" Class="mt-1">@L["tasks_empty_without_project"]</MudText>
                            }
                        </MudPaper>
                    }
                    else if (_view == "list")
                    {
                        <MudStack Spacing="2">
                            @foreach (var task in PagedTasks)
                            {
                                <MudPaper Class="pa-4 task-list-card" Elevation="0">
                                    <MudStack Spacing="2">
                                        <div class="d-flex justify-space-between align-start">
                                            <div class="d-flex flex-column" style="gap:.5rem;">
                                                <div class="d-flex" style="gap:.5rem; flex-wrap:wrap;">
                                                    <MudChip T="string" Size="Size.Small" Class="@GetStatusClass(task.Status)">
                                                        @GetStatusLabel(task.Status)
                                                    </MudChip>
                                                    <MudChip T="string" Size="Size.Small" Class="@GetPriorityClass(task.Priority)">
                                                        @GetPriorityLabel(task.Priority)
                                                    </MudChip>
                                                    @if (TryGetProjectName(task.ProjectId) is { } projectName)
                                                    {
                                                        <MudChip T="string"
                                                                 Size="Size.Small"
                                                                 Color="Color.Info"
                                                                 Variant="Variant.Outlined"
                                                                 Class="task-project-chip">
                                                            @($"{L["tasks_project"]}: {projectName}")
                                                        </MudChip>
                                                    }
                                                    @if (IsAssignedToMe(task))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                            Назначено мне
                                                        </MudChip>
                                                    }
                                                    @if (IsAuthoredByMe(task))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                                                            Я автор
                                                        </MudChip>
                                                    }
                                                    @if (!task.Assignees.Any())
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined">
                                                            @L["tasks_no_assignee"]
                                                        </MudChip>
                                                    }
                                                    @if (IsOverdue(task))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                                            Просрочено
                                                        </MudChip>
                                                    }
                                                </div>

                                                <MudText Typo="Typo.h6" Style="cursor:pointer" @onclick="@(() => SelectTask(task.Id))">
                                                    @task.Title
                                                </MudText>
                                            </div>

                                            @if (task.DueDate.HasValue)
                                            {
                                                <MudChip T="string"
                                                         Size="Size.Small"
                                                         Color="@(task.DueDate < KyrgyzstanTime.Now && task.Status != WorkTaskStatus.Done ? Color.Error : Color.Default)"
                                                         Variant="Variant.Outlined">
                                                    @string.Format(L["tasks_due_until"], KyrgyzstanTime.FormatDateSmart(task.DueDate.Value))
                                                </MudChip>
                                            }
                                        </div>

                                        <div class="d-flex justify-space-between align-center" style="gap:1rem; flex-wrap:wrap;">
                                            <MudText Typo="Typo.body2">
                                                @L["tasks_author"]: @task.AuthorName
                                                @if (task.Assignees.Count > 0)
                                                {
                                                    <span> | @L["tasks_assignee"]: @GetAssigneesDisplay(task.Assignees)</span>
                                                }
                                            </MudText>

                                            <div class="d-flex" style="gap:.5rem; flex-wrap:wrap;">
                                                <MudButton Size="Size.Small"
                                                           Variant="Variant.Outlined"
                                                           StartIcon="@Icons.Material.Filled.OpenInNew"
                                                           OnClick="@(() => SelectTask(task.Id))">
                                                    @L["tasks_open"]
                                                </MudButton>

                                                @if (CanTakeInWork(task))
                                                {
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Filled"
                                                               Color="Color.Primary"
                                                               StartIcon="@Icons.Material.Filled.PlayArrow"
                                                               OnClick="@(() => AcceptTaskAsync(task))">
                                                        @L["tasks_take"]
                                                    </MudButton>
                                                }

                                                @if (CanMoveToTodo(task))
                                                {
                                                    <MudButton Size="Size.Small"
                                                               Variant="Variant.Outlined"
                                                               StartIcon="@Icons.Material.Filled.AddTask"
                                                               OnClick="@(() => MoveTaskToTodoAsync(task))">
                                                        @L["tasks_move_todo"]
                                                    </MudButton>
                                                }

                                                @if (CanDelete(task))
                                                {
                                                    <MudTooltip Text="Удалить задачу">
                                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                                       Size="Size.Small"
                                                                       Color="Color.Error"
                                                                       OnClick="@(() => ConfirmDeleteTaskAsync(task.Id, task.Title))" />
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </div>
                                    </MudStack>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                    else
                    {
                        <MudGrid>
                            @foreach (var status in Enum.GetValues<WorkTaskStatus>().Where(s => s != WorkTaskStatus.Cancelled))
                            {
                                var columnTasks = BoardTasks.Where(t => t.Status == status).ToList();

                                <MudItem xs="12" md="6" xl="3">
                                    <MudPaper Class="pa-3 h-100 worktask-column-modern" Elevation="0">
                                        <MudStack Spacing="2">
                                            <div class="d-flex justify-space-between align-center">
                                                <MudText Typo="Typo.h6">@GetStatusLabel(status)</MudText>
                                                <MudChip T="string" Size="Size.Small">@columnTasks.Count</MudChip>
                                            </div>

                                            @foreach (var task in columnTasks)
                                            {
                                                <MudPaper Class="pa-3" Elevation="1">
                                                    <MudStack Spacing="1">
                                                        <div class="d-flex justify-space-between align-start" style="gap:.5rem;">
                                                            <MudText Typo="Typo.subtitle1" Style="cursor:pointer; flex:1" @onclick="@(() => SelectTask(task.Id))">
                                                                @task.Title
                                                            </MudText>

                                                            @if (CanDelete(task))
                                                            {
                                                                <MudTooltip Text="Удалить задачу">
                                                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                                                   Size="Size.Small"
                                                                                   Color="Color.Error"
                                                                                   OnClick="@(() => ConfirmDeleteTaskAsync(task.Id, task.Title))" />
                                                                </MudTooltip>
                                                            }
                                                        </div>

                                                        <div class="task-card-chips">
                                                            @if (IsAssignedToMe(task))
                                                            {
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                                    Назначено мне
                                                                </MudChip>
                                                            }
                                                            @if (IsAuthoredByMe(task))
                                                            {
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Outlined">
                                                                    Я автор
                                                                </MudChip>
                                                            }
                                                            @if (IsOverdue(task))
                                                            {
                                                                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">
                                                                    Просрочено
                                                                </MudChip>
                                                            }
                                                        </div>

                                                        <MudText Typo="Typo.caption">
                                                            @(task.Assignees.Count == 0 ? L["tasks_no_assignee"] : GetAssigneesDisplay(task.Assignees))
                                                        </MudText>

                                                        @if (TryGetProjectName(task.ProjectId) is { } projectName)
                                                        {
                                                            <MudText Typo="Typo.caption" Class="task-project-caption">
                                                                @($"{L["tasks_project"]}: {projectName}")
                                                            </MudText>
                                                        }

                                                        <MudChip T="string" Size="Size.Small" Class="@GetPriorityClass(task.Priority)">
                                                            @GetPriorityLabel(task.Priority)
                                                        </MudChip>

                                                        @if (task.DueDate.HasValue)
                                                        {
                                                            <MudText Typo="Typo.caption" Class="task-project-caption">
                                                                @string.Format(L["tasks_due_until"], KyrgyzstanTime.FormatDateSmart(task.DueDate.Value))
                                                            </MudText>
                                                        }
                                                    </MudStack>
                                                </MudPaper>
                                            }
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </div>

                @if (!_loading && _tasks.Count > 0 && _view == "list" && TotalPages > 1)
                {
                    <div class="tasks-pagination-bar tasks-pagination-bar--sticky">
                        <MudText Typo="Typo.caption">
                            @string.Format(L["tasks_pagination"], PaginationStart, PaginationEnd, _tasks.Count)
                        </MudText>
                        <MudPagination Count="@TotalPages"
                                       Selected="@_currentPage"
                                       SelectedChanged="OnPageChanged"
                                       Size="Size.Small"
                                       Variant="Variant.Outlined"
                                       BoundaryCount="1"
                                       MiddleCount="1" />
                    </div>
                }
            </div>
        </MudItem>
    </MudGrid>
</MudStack>

@* ── Task Detail Dialog ── *@
<MudDialog @bind-Visible="_taskDialogOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = false, BackdropClick = false, CloseOnEscapeKey = false })">
    <TitleContent>
        <div class="tdlg-header">
            @if (_selectedTask is not null)
            {
                <div class="tdlg-header-bar" style="background:@GetStatusAccentColor(_selectedTask.Status)"></div>
            }
            <div class="tdlg-header-body">
                <div class="tdlg-header-title">
                    @(_selectedTask?.Title ?? L["tasks_loading_detail"])
                </div>
                @if (_selectedTask is not null)
                {
                    <div class="tdlg-header-meta">
                        @if (TryGetProjectName(_selectedTask.ProjectId) is { } hProj)
                        {
                            <span class="tdlg-meta-chip tdlg-meta-chip--project">
                                <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Small" />
                                @hProj
                            </span>
                        }
                        <span class="tdlg-meta-chip @GetPriorityClass(_selectedTask.Priority)">
                            @GetPriorityLabel(_selectedTask.Priority)
                        </span>
                        @if (_selectedTask.DueDate.HasValue)
                        {
                            <span class="tdlg-meta-chip @(IsOverdue(_selectedTask) ? "tdlg-meta-chip--overdue" : "tdlg-meta-chip--date")">
                                <MudIcon Icon="@Icons.Material.Outlined.CalendarMonth" Size="Size.Small" />
                                до @KyrgyzstanTime.FormatDateSmart(_selectedTask.DueDate.Value)
                            </span>
                        }
                    </div>
                }
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                           Class="tdlg-close" OnClick="CloseTask" />
        </div>
    </TitleContent>

    <DialogContent>
        @if (_loadingTask)
        {
            <div class="tdlg-state">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Large" />
                <p class="tdlg-state-text">@L["tasks_loading_detail"]</p>
            </div>
        }
        else if (_selectedTask is null)
        {
            <div class="tdlg-state">
                <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" Color="Color.Warning" />
                <p class="tdlg-state-text">@L["tasks_not_found"]</p>
                <MudButton Variant="Variant.Outlined" OnClick="CloseTask">@L["btn_cancel"]</MudButton>
            </div>
        }
        else
        {
            <div class="tdlg-body">

                @* ── LEFT ── *@
                <div class="tdlg-left">

                    @* Custom tab bar — no MudBlazor fights *@
                    <div class="tdlg-tabs">
                        <button class="tdlg-tab @(_activeTab==0?"tdlg-tab--on":"")" @onclick="@(()=>_activeTab=0)">
                            Описание
                        </button>
                        @{ var ckD = _selectedTask.Checklist.Count(i=>i.IsChecked); var ckT = _selectedTask.Checklist.Count; }
                        <button class="tdlg-tab @(_activeTab==1?"tdlg-tab--on":"")" @onclick="@(()=>_activeTab=1)">
                            Чеклист
                            @if (ckT > 0)
                            {
                                <span class="tdlg-tab-badge @(ckD==ckT?"tdlg-tab-badge--done":"")">@ckD/@ckT</span>
                            }
                        </button>
                        <button class="tdlg-tab @(_activeTab==2?"tdlg-tab--on":"")" @onclick="@(()=>_activeTab=2)">
                            Комментарии
                            @if (_selectedTask.Comments.Count > 0)
                            {
                                <span class="tdlg-tab-badge">@_selectedTask.Comments.Count</span>
                            }
                        </button>
                        <button class="tdlg-tab @(_activeTab==3?"tdlg-tab--on":"")" @onclick="@(()=>_activeTab=3)">
                            Файлы
                            @if (_selectedTask.Attachments.Count > 0)
                            {
                                <span class="tdlg-tab-badge">@_selectedTask.Attachments.Count</span>
                            }
                        </button>
                    </div>

                    @* Tab content *@
                    <div class="tdlg-content">

                        @* Description *@
                        @if (_activeTab == 0)
                        {
                            @* Meta info *@
                            <div class="tdlg-desc-meta">
                                <div class="tdlg-desc-meta-row">
                                    <MudIcon Icon="@Icons.Material.Outlined.Person" Size="Size.Small" Class="tdlg-info-icon" />
                                    <div>
                                        <div class="tdlg-info-lbl">@L["tasks_author"]</div>
                                        <div class="tdlg-info-val">@_selectedTask.AuthorName</div>
                                    </div>
                                </div>
                                @if (TryGetProjectName(_selectedTask.ProjectId) is { } dProj)
                                {
                                    <div class="tdlg-desc-meta-row">
                                        <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Small" Class="tdlg-info-icon" />
                                        <div>
                                            <div class="tdlg-info-lbl">@L["tasks_project"]</div>
                                            <div class="tdlg-info-val">@dProj</div>
                                        </div>
                                    </div>
                                }
                                <div class="tdlg-desc-meta-row">
                                    <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="tdlg-info-icon" />
                                    <div>
                                        <div class="tdlg-info-lbl">Создана</div>
                                        <div class="tdlg-info-val">@KyrgyzstanTime.FormatDateTime(_selectedTask.CreatedAt)</div>
                                    </div>
                                </div>
                                @if (_selectedTask.DueDate.HasValue)
                                {
                                    <div class="tdlg-desc-meta-row">
                                        <MudIcon Icon="@Icons.Material.Outlined.Event" Size="Size.Small" Class="tdlg-info-icon" />
                                        <div>
                                            <div class="tdlg-info-lbl">@L["tasks_due"]</div>
                                            <div class="tdlg-info-val @(IsOverdue(_selectedTask) ? "tdlg-overdue" : "")">
                                                @KyrgyzstanTime.FormatDateSmart(_selectedTask.DueDate.Value)
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>

                            @* Description text *@
                            @if (!string.IsNullOrWhiteSpace(_selectedTask.Description))
                            {
                                <div class="tdlg-desc-divider"></div>
                                <p class="tdlg-description">@_selectedTask.Description</p>
                            }
                        }

                        @* Checklist *@
                        else if (_activeTab == 1)
                        {
                            @if (ckT > 0)
                            {
                                <div class="tdlg-progress-row">
                                    <div class="tdlg-progress-bar-wrap">
                                        <div class="tdlg-progress-fill"
                                             style="width:@(ckD*100/ckT)%; background:@(ckD==ckT?"#10b981":"var(--mud-palette-primary)")">
                                        </div>
                                    </div>
                                    <span class="tdlg-progress-label">@ckD / @ckT</span>
                                </div>
                            }
                            @if (ckT == 0)
                            {
                                <div class="tdlg-empty">
                                    <MudIcon Icon="@Icons.Material.Outlined.CheckBoxOutlineBlank" Size="Size.Large" Style="opacity:.18" />
                                    <span>Чеклист пуст</span>
                                </div>
                            }
                            <div class="tdlg-checklist">
                                @foreach (var item in _selectedTask.Checklist.OrderBy(i => i.Position))
                                {
                                    <div class="tdlg-check-row @(_editingChecklistId == item.Id ? "tdlg-check-row--editing" : "")">
                                        <MudCheckBox T="bool" Color="Color.Primary"
                                                     Value="item.IsChecked"
                                                     ValueChanged="@(async _ => await ToggleChecklistAsync(item.Id))" />

                                        @if (_editingChecklistId == item.Id)
                                        {
                                            <MudTextField T="string"
                                                          Value="_editingChecklistText"
                                                          ValueChanged="@(v => _editingChecklistText = v)"
                                                          Variant="Variant.Text"
                                                          Margin="Margin.Dense"
                                                          AutoFocus="true"
                                                          Immediate="true"
                                                          Style="flex:1"
                                                          OnKeyDown="HandleChecklistEditKeyDown"
                                                          onblur="@(async () => await SaveChecklistEditAsync())" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Check"
                                                           Size="Size.Small" Color="Color.Success"
                                                           OnClick="SaveChecklistEditAsync" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                           Size="Size.Small"
                                                           OnClick="CancelChecklistEdit" />
                                        }
                                        else
                                        {
                                            <span class="@(item.IsChecked ? "tdlg-check-done" : "tdlg-check-text") tdlg-check-editable"
                                                  title="Нажмите чтобы изменить"
                                                  @onclick="@(() => StartChecklistEdit(item.Id, item.Text))">
                                                @item.Text
                                            </span>
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                           Size="Size.Small" Color="Color.Error"
                                                           Class="tdlg-row-btn"
                                                           OnClick="@(() => DeleteChecklistAsync(item.Id))" />
                                        }
                                    </div>
                                }
                            </div>
                            <div class="tdlg-add-row">
                                <MudTextField @bind-Value="_newChecklistText"
                                              Placeholder="@L["tasks_new_checklist_item"]"
                                              Variant="Variant.Outlined" Margin="Margin.Dense"
                                              Style="flex:1" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="AddChecklistAsync">@L["btn_add"]</MudButton>
                            </div>
                        }

                        @* Comments *@
                        else if (_activeTab == 2)
                        {
                            @if (_selectedTask.Comments.Count == 0)
                            {
                                <div class="tdlg-empty">
                                    <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Large" Style="opacity:.18" />
                                    <span>@L["tasks_no_comments"]</span>
                                </div>
                            }
                            <div class="tdlg-comments">
                                @foreach (var c in _selectedTask.Comments.OrderByDescending(c => c.CreatedAt))
                                {
                                    <div class="tdlg-comment">
                                        <div class="tdlg-avatar">@c.AuthorName[0].ToString().ToUpper()</div>
                                        <div class="tdlg-comment-body">
                                            <div class="tdlg-comment-meta">
                                                <span class="tdlg-comment-author">@c.AuthorName</span>
                                                <span class="tdlg-comment-time">@KyrgyzstanTime.FormatDateTime(c.CreatedAt)</span>
                                            </div>
                                            <p class="tdlg-comment-text">@c.Text</p>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="tdlg-comment-input">
                                <MudTextField @bind-Value="_newComment"
                                              Placeholder="@L["tasks_add_comment"]"
                                              Lines="3" Variant="Variant.Outlined" />
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           FullWidth="true" Class="mt-2"
                                           OnClick="AddCommentAsync">
                                    @L["tasks_send_comment"]
                                </MudButton>
                            </div>
                        }

                        @* Files *@
                        else
                        {
                            <div class="task-files-toolbar" style="margin-bottom:12px">
                                <MudCheckBox @bind-Value="_pinUploads" Label="@L["tasks_pin_uploads"]" Color="Color.Primary" />
                                <div class="task-upload-bar">
                                    <InputFile id="task-file-upload" class="file-picker-input"
                                               accept="@FileUploadRules.AcceptAttribute"
                                               OnChange="UploadTaskFilesAsync" multiple />
                                    <label for="task-file-upload"
                                           class="file-picker-trigger file-picker-trigger--task-icon"
                                           title="@L["tasks_add_attachments"]">
                                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" />
                                        <span>@L["tasks_add_files"]</span>
                                    </label>
                                </div>
                            </div>
                            @if (_selectedTask.Attachments.Count == 0)
                            {
                                <div class="tdlg-empty">
                                    <MudIcon Icon="@Icons.Material.Outlined.FolderOpen" Size="Size.Large" Style="opacity:.18" />
                                    <span>@L["tasks_no_files"]</span>
                                </div>
                            }
                            @foreach (var att in OrderedAttachments)
                            {
                                <MudPaper Class="task-attachment-card" Outlined="true" Elevation="0">
                                    <div class="task-attachment-row">
                                        <button type="button" @onclick="@(() => DownloadAttachmentAsync(att))"
                                                class="task-attachment-main">
                                            <span class="task-attachment-icon @GetAttachmentAccentClass(att)">
                                                <MudIcon Icon="@GetAttachmentIcon(att)" />
                                            </span>
                                            <span class="task-attachment-copy">
                                                <span class="task-attachment-name">@att.FileName</span>
                                                <span class="task-attachment-meta">@att.UploadedByName · @FormatBytes(att.Size)</span>
                                            </span>
                                        </button>
                                        <div class="task-attachment-actions">
                                            @if (att.IsPinned)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning"
                                                         Variant="Variant.Filled" Class="task-attachment-pin-chip">
                                                    @L["tasks_pinned"]
                                                </MudChip>
                                            }
                                            <div class="task-attachment-action-buttons">
                                                <MudIconButton Icon="@(att.IsPinned ? Icons.Material.Filled.PushPin : Icons.Material.Outlined.PushPin)"
                                                               Size="Size.Small" Class="task-attachment-icon-btn"
                                                               OnClick="@(() => ToggleAttachmentPinAsync(att.Id))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                               Size="Size.Small" Color="Color.Error"
                                                               Class="task-attachment-icon-btn"
                                                               OnClick="@(() => DeleteAttachmentAsync(att.Id))" />
                                            </div>
                                        </div>
                                    </div>
                                </MudPaper>
                            }
                        }

                    </div>
                </div>

                @* ── RIGHT ── *@
                <div class="tdlg-right">

                    @* Status *@
                    <div class="tdlg-section">
                        <div class="tdlg-section-title">Статус</div>
                        <div class="tdlg-status-list">
                            @foreach (var st in Enum.GetValues<WorkTaskStatus>())
                            {
                                var isOn = st == _selectedTask.Status;
                                var canClick = CanUpdateStatus(_selectedTask) && !isOn;
                                <button type="button"
                                        class="tdlg-status-btn @(isOn ? "tdlg-status-btn--on" : "") @(!canClick && !isOn ? "tdlg-status-btn--locked" : "")"
                                        @onclick="@(canClick ? (() => ChangeStatusDirectAsync(st)) : null)">
                                    <span class="tdlg-status-dot" style="background:@GetStatusDotColor(st); @(!isOn?"opacity:.25":"")"></span>
                                    <span style="@(isOn?$"color:{GetStatusDotColor(st)}":"")">@GetStatusLabel(st)</span>
                                    @if (isOn) { <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Class="tdlg-status-check" /> }
                                </button>
                            }
                        </div>
                    </div>

                    @* Assignees *@
                    <div class="tdlg-section tdlg-section--sep">
                        <div class="tdlg-section-title-row">
                            <span class="tdlg-section-title">@L["tasks_assignee"]</span>
                            @if (_selectedTask.Assignees.Count > 0)
                            {
                                <span class="tdlg-count-badge">@_selectedTask.Assignees.Count</span>
                            }
                        </div>
                        @if (_selectedTask.Assignees.Count == 0)
                        {
                            <p class="tdlg-muted">@L["tasks_no_assignee"]</p>
                        }
                        @foreach (var resp in _selectedTask.Assignees.Where(a => a.IsOwnerAssigned))
                        {
                            var children = _selectedTask.Assignees.Where(a => !a.IsOwnerAssigned && a.AssignedById == resp.UserId).ToList();
                            <div class="task-dlg-tree-block">
                                <div class="task-dlg-assignee-row task-dlg-assignee-row--resp">
                                    <div class="task-dlg-avatar task-dlg-avatar--sm task-dlg-avatar--resp">@resp.UserName[0].ToString().ToUpper()</div>
                                    <div class="task-dlg-assignee-info">
                                        <span class="task-dlg-assignee-name">@resp.UserName</span>
                                        <span class="task-dlg-assignee-role task-dlg-assignee-role--resp">Ответственный</span>
                                    </div>
                                    @if (CanRemoveAssignee(_selectedTask, resp))
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small" Color="Color.Error"
                                                       Class="task-dlg-row-action task-dlg-assignee-remove"
                                                       OnClick="@(() => RemoveAssigneeFromTaskAsync(resp.UserId))" />
                                    }
                                </div>
                                @if (children.Any())
                                {
                                    <div class="task-dlg-tree-children">
                                        @foreach (var ch in children)
                                        {
                                            <div class="task-dlg-assignee-row task-dlg-assignee-row--child">
                                                <div class="task-dlg-avatar task-dlg-avatar--sm">@ch.UserName[0].ToString().ToUpper()</div>
                                                <div class="task-dlg-assignee-info">
                                                    <span class="task-dlg-assignee-name">@ch.UserName</span>
                                                    <span class="task-dlg-assignee-role">Соисполнитель</span>
                                                </div>
                                                @if (CanRemoveAssignee(_selectedTask, ch))
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small" Color="Color.Error"
                                                                   Class="task-dlg-row-action task-dlg-assignee-remove"
                                                                   OnClick="@(() => RemoveAssigneeFromTaskAsync(ch.UserId))" />
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        @{ var orph = _selectedTask.Assignees.Where(a => !a.IsOwnerAssigned && !_selectedTask.Assignees.Any(r => r.IsOwnerAssigned && r.UserId == a.AssignedById)).ToList(); }
                        @foreach (var o in orph)
                        {
                            <div class="task-dlg-assignee-row">
                                <div class="task-dlg-avatar task-dlg-avatar--sm">@o.UserName[0].ToString().ToUpper()</div>
                                <div class="task-dlg-assignee-info">
                                    <span class="task-dlg-assignee-name">@o.UserName</span>
                                    <span class="task-dlg-assignee-role">Соисполнитель</span>
                                </div>
                                @if (CanRemoveAssignee(_selectedTask, o))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Size="Size.Small" Color="Color.Error"
                                                   Class="task-dlg-row-action task-dlg-assignee-remove"
                                                   OnClick="@(() => RemoveAssigneeFromTaskAsync(o.UserId))" />
                                }
                            </div>
                        }
                        @if (CanAddAssignee(_selectedTask))
                        {
                            var wbo = _selectedTask.AuthorId == _currentUserId;
                            <div class="tdlg-add-hint">
                                <MudIcon Icon="@(wbo ? Icons.Material.Filled.Star : Icons.Material.Outlined.GroupAdd)" Size="Size.Small" Style="opacity:.55" />
                                <span>Добавить как: <strong>@(wbo ? "Ответственный" : "Соисполнитель")</strong></span>
                            </div>
                            <MudStack Row AlignItems="AlignItems.Center" Spacing="1" Class="mt-1">
                                <MudSelect T="string" @bind-Value="_addAssigneeId"
                                           Placeholder="Выбрать..." Variant="Variant.Outlined"
                                           Margin="Margin.Dense" Style="flex:1">
                                    @foreach (var u in _users.Where(u => _selectedTask.Assignees.All(a => a.UserId != u.Id)))
                                    {
                                        <MudSelectItem Value="@u.Id">@u.UserName</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Color="Color.Primary"
                                               Disabled="@string.IsNullOrWhiteSpace(_addAssigneeId)"
                                               OnClick="AddAssigneeToTaskAsync" />
                            </MudStack>
                        }
                    </div>

                    @* Actions *@
                    @if (CanTakeInWork(_selectedTask) || CanMoveToTodo(_selectedTask) || CanDelete(_selectedTask))
                    {
                        <div class="tdlg-section tdlg-section--sep">
                            <div class="tdlg-section-title">Действия</div>
                            <MudStack Spacing="1">
                                @if (CanTakeInWork(_selectedTask))
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.PlayArrow"
                                               OnClick="@(() => AcceptTaskAsync(_selectedTask))">@L["tasks_take"]</MudButton>
                                }
                                @if (CanMoveToTodo(_selectedTask))
                                {
                                    <MudButton Variant="Variant.Outlined" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.AddTask"
                                               OnClick="@(() => MoveTaskToTodoAsync(_selectedTask))">@L["tasks_move_todo_full"]</MudButton>
                                }
                                @if (CanDelete(_selectedTask))
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" FullWidth="true"
                                               StartIcon="@Icons.Material.Filled.DeleteOutline"
                                               OnClick="@(() => ConfirmDeleteTaskAsync(_selectedTask.Id, _selectedTask.Title))">@L["tasks_delete_title"]</MudButton>
                                }
                            </MudStack>
                        </div>
                    }

                </div>
            </div>
        }
    </DialogContent>
</MudDialog>

<MudDialog @bind-Visible="_createOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["tasks_new"]</MudText>
    </TitleContent>

    <DialogContent>
        <MudStack Spacing="2">
            <MudTextField @bind-Value="_newTitle"
                          Label="@L["field_name"]"
                          Required="true"
                          Variant="Variant.Outlined" />

            <MudTextField @bind-Value="_newDesc"
                          Label="@L["field_desc"]"
                          Lines="3"
                          Variant="Variant.Outlined" />

            <MudSelect T="WorkTaskPriority"
                       @bind-Value="_newPriority" 
                       Label="@L["tasks_priority"]"
                       Variant="Variant.Outlined">
                <MudSelectItem Value="WorkTaskPriority.Low">@L["priority_low_f"]</MudSelectItem>
                <MudSelectItem Value="WorkTaskPriority.Medium">@L["priority_medium_f"]</MudSelectItem>
                <MudSelectItem Value="WorkTaskPriority.High">@L["priority_high_f"]</MudSelectItem>
                <MudSelectItem Value="WorkTaskPriority.Critical">@L["priority_critical_f"]</MudSelectItem>
            </MudSelect>

            <div class="cal-participants-label">
                <span class="cal-participants-label__text">@L["tasks_assignee"]</span>
                @if (_users.Count > 0)
                {
                    var allAssigned = _newAssigneeIds.Count() == _users.Count;
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                               StartIcon="@(allAssigned ? Icons.Material.Filled.RemoveDone : Icons.Material.Filled.DoneAll)"
                               OnClick="@(() => { _newAssigneeIds = allAssigned ? (IEnumerable<string>)[] : _users.Select(u => u.Id).ToList(); })">
                        @(allAssigned ? L["cal_deselect_all"] : L["cal_select_all"])
                    </MudButton>
                }
            </div>
            <MudSelect T="string"
                       @bind-SelectedValues="_newAssigneeIds"
                       Label="@L["tasks_assignee"]"
                       Variant="Variant.Outlined"
                       MultiSelection="true"
                       Clearable="true"
                       ToStringFunc="@(id => _users.FirstOrDefault(u => u.Id == id)?.UserName ?? id)">
                @foreach (var user in _users)
                {
                    <MudSelectItem Value="@user.Id">@user.UserName</MudSelectItem>
                }
            </MudSelect>

            <MudDatePicker @bind-Date="_newDueDate"
                           Label="@L["tasks_due"]"
                           Variant="Variant.Outlined"
                           Clearable="true" />
            <TimeInput @bind-Time="_newDueTime"
                       Label="@L["tasks_due_time"]"
                       Clearable="true" />
        </MudStack>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => _createOpen = false)">
            @L["btn_cancel"]
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateTaskAsync">
            @L["btn_create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public Guid? TaskId { get; set; }
    [SupplyParameterFromQuery(Name = "project")] public Guid? ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "scope")] public string? Scope { get; set; }
    [SupplyParameterFromQuery(Name = "my")] public bool MyOnly { get; set; }
    [SupplyParameterFromQuery(Name = "author")] public bool AuthorOnly { get; set; }
    [SupplyParameterFromQuery(Name = "overdue")] public bool OverdueOnly { get; set; }

    private const string ProjectFilterNone = "none";
    private const string ProjectFilterAll = "all";
    private List<WorkTaskSummary> _tasks = [];
    private List<WorkTaskSummary> _rawTasks = [];
    private List<UserDto> _users = [];
    private List<Project> _projects = [];
    private WorkTaskDetailDto? _selectedTask;
    private bool _loading = true;
    private bool _loadingTask;
    private string _view = "list";
    private string? _filterStatus;
    private string _searchText = string.Empty;
    private string _projectFilterValue = ProjectFilterAll;
    private bool _myOnly;
    private bool _authorOnly;
    private bool _overdueOnly;
    private bool _createOpen;
    private bool _taskDialogOpen;
    private int _activeTab;
    private string _newTitle = "";
    private string? _newDesc;
    private WorkTaskPriority _newPriority = WorkTaskPriority.Medium;
    private IEnumerable<string> _newAssigneeIds = [];
    private DateTime? _newDueDate;
    private TimeSpan? _newDueTime;
    private string _currentUserId = string.Empty;
    private WorkTaskStatus _selectedStatus;
    private string? _addAssigneeId;
    private string _newComment = string.Empty;
    private string _newChecklistText = string.Empty;
    private Guid? _editingChecklistId;
    private string _editingChecklistText = string.Empty;
    private bool _pinUploads = true;
    private Project? _currentProject;
    private Guid? _lastProjectId;
    private string? _lastScope;
    private int _currentPage = 1;
    private const int PageSize = 8;

    private IEnumerable<FileAttachmentDto> OrderedAttachments => _selectedTask is null
        ? []
        : _selectedTask.Attachments
            .OrderByDescending(a => a.IsPinned)
            .ThenByDescending(a => a.UploadedAt);

    private IEnumerable<WorkTaskSummary> PagedTasks => _tasks
        .Skip((_currentPage - 1) * PageSize)
        .Take(PageSize);

    private IEnumerable<WorkTaskSummary> BoardTasks => _tasks;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(_tasks.Count / (double)PageSize));
    private int PaginationStart => _tasks.Count == 0 ? 0 : ((_currentPage - 1) * PageSize) + 1;
    private int PaginationEnd => Math.Min(_currentPage * PageSize, _tasks.Count);
    private bool IsWithoutProjectMode => _projectFilterValue == ProjectFilterNone;
    private bool IsAllTasksMode => _projectFilterValue == ProjectFilterAll;
    private Guid? SelectedProjectId => Guid.TryParse(_projectFilterValue, out var projectId) ? projectId : null;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? string.Empty;

        var usersTask = EmployeeSvc.GetAllAsync(excludeAdmins: true);
        var projectsTask = ProjectSvc.GetAllAsync();

        await Task.WhenAll(usersTask, projectsTask);

        _users = await usersTask;
        _projects = await projectsTask;
        SetProjectFilterFromRoute();
        if (MyOnly) _myOnly = true;
        if (AuthorOnly) _authorOnly = true;
        if (OverdueOnly) _overdueOnly = true;
        _currentProject = ResolveCurrentProject();
        _lastProjectId = ProjectId;
        _lastScope = Scope;

        await LoadTasksAsync();
        await LoadSelectedTaskAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        SetProjectFilterFromRoute();
        _currentProject = ResolveCurrentProject();

        if ((_lastProjectId != ProjectId || _lastScope != Scope) && _projects.Count > 0)
        {
            _lastProjectId = ProjectId;
            _lastScope = Scope;
            await LoadTasksAsync();
        }

        await LoadSelectedTaskAsync();
    }

    private async Task LoadTasksAsync()
    {
        _loading = true;
        try
        {
            _rawTasks = _myOnly
                ? await TaskSvc.GetMyAsync()
                : await TaskSvc.GetAllAsync(_filterStatus, null, SelectedProjectId, IsWithoutProjectMode);

            ApplyClientTaskFilters();

            NormalizePagination();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSelectedTaskAsync()
    {
        if (TaskId is null)
        {
            _selectedTask = null;
            _taskDialogOpen = false;
            return;
        }

        _taskDialogOpen = true;
        _loadingTask = true;
        try
        {
            _selectedTask = await TaskSvc.GetAsync(TaskId.Value);
            if (_selectedTask is not null)
            {
                _selectedStatus = _selectedTask.Status;
                _addAssigneeId = null;
            }
        }
        catch
        {
            _selectedTask = null;
        }
        finally
        {
            _loadingTask = false;
        }
    }

    private void SelectTask(Guid id)
        => Nav.NavigateTo(BuildTasksUrl(id));

    private void CloseTask()
    {
        _taskDialogOpen = false;
        Nav.NavigateTo(BuildTasksUrl());
    }

    private async Task ClearProjectFilter()
        => await OnProjectFilterChangedAsync(ProjectFilterAll);

    private void OpenCreateDialog()
    {
        _newTitle = string.Empty;
        _newDesc = null;
        _newPriority = WorkTaskPriority.Medium;
        _newAssigneeIds = [];
        _newDueDate = null;
        _newDueTime = null;
        _createOpen = true;
    }

    private async Task CreateTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle))
            return;

        var dueDate = _newDueDate.HasValue
            ? _newDueDate.Value.Date + (_newDueTime ?? TimeSpan.Zero)
            : (DateTime?)null;

        await TaskSvc.CreateAsync(new CreateWorkTaskRequest(
            _newTitle,
            _newDesc,
            _newPriority,
            _newAssigneeIds.ToArray(),
            null,
            dueDate,
            null,
            SelectedProjectId));

        _createOpen = false;
        Snackbar.Add(L["tasks_created"], Severity.Success);
        await LoadTasksAsync();
    }

    private async Task OnProjectFilterChangedAsync(string value)
    {
        _projectFilterValue = value;
        _currentPage = 1;
        _currentProject = ResolveCurrentProject();
        var nextUrl = BuildTasksUrl(TaskId);
        var currentRelativeUrl = Nav.ToBaseRelativePath(Nav.Uri);
        if (!string.Equals(currentRelativeUrl, nextUrl.TrimStart('/'), StringComparison.OrdinalIgnoreCase))
        {
            Nav.NavigateTo(nextUrl);
            return;
        }
        await LoadTasksAsync();
    }

    private async Task OnStatusFilterChangedAsync(string? value)
    {
        _filterStatus = value;
        _currentPage = 1;
        await LoadTasksAsync();
    }

    private async Task OnMyOnlyChangedAsync(bool value)
    {
        _myOnly = value;
        _currentPage = 1;
        await LoadTasksAsync();
    }

    private void OnSearchTextChanged(string value)
    {
        _searchText = value;
        _currentPage = 1;
        ApplyClientTaskFilters();
        NormalizePagination();
    }

    private Project? ResolveCurrentProject()
        => SelectedProjectId.HasValue ? _projects.FirstOrDefault(project => project.Id == SelectedProjectId.Value) : null;

    private string? TryGetProjectName(Guid? projectId)
        => projectId.HasValue
            ? _projects.FirstOrDefault(project => project.Id == projectId.Value)?.Name
            : null;

    private string FormatProjectSelectValue(string value)
        => value switch
        {
            ProjectFilterNone => L["tasks_without_project"],
            ProjectFilterAll => L["tasks_all_tasks"],
            _ => Guid.TryParse(value, out var projectId) ? TryGetProjectName(projectId) ?? value : value
        };

    private void SetProjectFilterFromRoute()
    {
        if (ProjectId.HasValue)
        {
            _projectFilterValue = ProjectId.Value.ToString();
            return;
        }

        _projectFilterValue = string.Equals(Scope, ProjectFilterNone, StringComparison.OrdinalIgnoreCase)
            ? ProjectFilterNone
            : ProjectFilterAll;
    }

    private string BuildTasksUrl(Guid? taskId = null)
    {
        var path = taskId.HasValue ? $"/tasks/{taskId}" : "/tasks";
        if (SelectedProjectId.HasValue)
            return $"{path}?project={SelectedProjectId}";
        if (IsAllTasksMode)
            return $"{path}?scope={ProjectFilterAll}";
        return path;
    }

    private void ApplyClientTaskFilters()
    {
        _tasks = _rawTasks.ToList();

        if (_authorOnly)
        {
            _tasks = _tasks.Where(task => task.AuthorId == _currentUserId).ToList();
        }

        if (_overdueOnly)
        {
            _tasks = _tasks
                .Where(task => task.DueDate.HasValue
                    && task.DueDate.Value < KyrgyzstanTime.Now
                    && task.Status is not WorkTaskStatus.Done and not WorkTaskStatus.Cancelled)
                .ToList();
        }

        if (_myOnly)
        {
            if (IsWithoutProjectMode)
                _tasks = _tasks.Where(task => task.ProjectId is null).ToList();
            else if (SelectedProjectId.HasValue)
                _tasks = _tasks.Where(task => task.ProjectId == SelectedProjectId).ToList();

            if (!string.IsNullOrWhiteSpace(_filterStatus) && Enum.TryParse<WorkTaskStatus>(_filterStatus, out var parsedStatus))
                _tasks = _tasks.Where(task => task.Status == parsedStatus).ToList();
        }

        if (!string.IsNullOrWhiteSpace(_searchText))
        {
            var search = _searchText.Trim();
            _tasks = _tasks
                .Where(task =>
                    ContainsSearch(task.Title, search) ||
                    ContainsSearch(task.AuthorName, search) ||
                    task.Assignees.Any(a => ContainsSearch(a.UserName, search)) ||
                    ContainsSearch(task.ProjectName, search) ||
                    ContainsSearch(TryGetProjectName(task.ProjectId), search))
                .ToList();
        }
    }

    private static bool ContainsSearch(string? value, string search)
        => !string.IsNullOrWhiteSpace(value)
           && value.Contains(search, StringComparison.OrdinalIgnoreCase);

