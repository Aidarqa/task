    private void StartChecklistEdit(Guid itemId, string currentText)
    {
        _editingChecklistId = itemId;
        _editingChecklistText = currentText;
    }

    private void CancelChecklistEdit()
    {
        _editingChecklistId = null;
        _editingChecklistText = string.Empty;
    }

    private async Task SaveChecklistEditAsync()
    {
        if (_editingChecklistId is null || _selectedTask is null) return;
        var text = _editingChecklistText.Trim();
        if (string.IsNullOrWhiteSpace(text)) { CancelChecklistEdit(); return; }

        var itemId = _editingChecklistId.Value;
        var item = _selectedTask.Checklist.FirstOrDefault(i => i.Id == itemId);

        // No change — skip API call
        if (item is not null && item.Text == text) { CancelChecklistEdit(); return; }

        CancelChecklistEdit();

        await TaskSvc.UpdateChecklistItemTextAsync(_selectedTask.Id, itemId, text);
        if (item is not null) item.Text = text;
    }

    private async Task HandleChecklistEditKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveChecklistEditAsync();
        else if (e.Key == "Escape") CancelChecklistEdit();
    }

    private async Task ToggleChecklistAsync(Guid itemId)
    {
        if (_selectedTask is null)
            return;

        await TaskSvc.ToggleChecklistItemAsync(_selectedTask.Id, itemId);
        var item = _selectedTask.Checklist.FirstOrDefault(i => i.Id == itemId);
        if (item is not null)
            item.IsChecked = !item.IsChecked;

        await LoadTasksAsync();
    }

    private async Task DeleteChecklistAsync(Guid itemId)
    {
        if (_selectedTask is null)
            return;

        await TaskSvc.DeleteChecklistItemAsync(_selectedTask.Id, itemId);
        _selectedTask.Checklist.RemoveAll(i => i.Id == itemId);
        await LoadTasksAsync();
    }
    private async Task UploadTaskFilesAsync(InputFileChangeEventArgs args)
    {
        if (_selectedTask is null)
            return;

        var files = args.GetMultipleFiles().ToList();
        if (files.Count == 0)
            return;

        try
        {
            var uploaded = await TaskSvc.UploadAttachmentsAsync(_selectedTask.Id, files, _pinUploads);
            if (uploaded.Count > 0)
            {
                await RefreshAfterTaskChange(_selectedTask.Id);
                Snackbar.Add(L["tasks_files_attached"], Severity.Success);
            }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

