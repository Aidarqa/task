    private async Task DeleteTaskAsync(Guid taskId)
    {
        await TaskSvc.DeleteAsync(taskId);

        _tasks.RemoveAll(task => task.Id == taskId);
        NormalizePagination();

        if (TaskId == taskId)
        {
            _selectedTask = null;
            CloseTask();
        }

        Snackbar.Add(L["tasks_deleted"], Severity.Info);
    }

