    private static string GetAssigneesDisplay(List<WorkTaskAssigneeDto> assignees)
    {
        if (assignees.Count == 0) return string.Empty;
        var names = string.Join(", ", assignees.Take(2).Select(a => a.UserName));
        return assignees.Count > 2 ? $"{names} +{assignees.Count - 2}" : names;
    }

