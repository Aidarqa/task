@page "/chats"
@using Microsoft.AspNetCore.Components.Forms
@attribute [Authorize]
@inherits LocalizedBase
@inject ChatClientService ChatSvc
@inject EmployeeService EmployeeSvc
@inject NotificationClientService NotifSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthState
@inject FileDownloadService FileDownloader
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@L["chat_title"] - @L["app_name"]</PageTitle>

<MudStack Style="height: calc(100vh - 64px);">
    <div class="chat-page-shell">
        <div class="chat-page-header">
            <div>
                <MudText Typo="Typo.h4" Class="chat-page-title">@L["chat_title"]</MudText>
                <MudText Typo="Typo.body2" Class="chat-page-subtitle">
                    @L["chat_subtitle"]
                </MudText>
            </div>
        </div>

        <div class="chats-layout-modern">
            <!-- Sidebar -->
            <MudPaper Class="chats-sidebar-modern" Elevation="0">
                <div class="chats-sidebar-header-modern">
                    <div>
                        <MudText Typo="Typo.h6" Class="sidebar-title">@L["chat_title"]</MudText>
                        <MudText Typo="Typo.caption" Class="sidebar-subtitle">
                            @L["chat_sidebar_subtitle"]
                        </MudText>
                    </div>

                    <MudIconButton Icon="@Icons.Material.Filled.Add"
                                   Size="Size.Medium"
                                   Color="Color.Primary"
                                   OnClick="OpenNewChat"
                                   Class="new-chat-btn" />
                </div>

                <div class="chat-search-wrap">
                    <MudTextField @bind-Value="_search"
                                  Placeholder="@L["search"]"
                                  Dense="true"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  FullWidth="true" />
                </div>

                <div class="chats-list-modern">
                    @if (_chats.Count == 0)
                    {
                        <div class="chat-list-empty">
                            <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" />
                            <MudText Typo="Typo.body2">@L["chat_no_chats"]</MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var chat in FilteredChats)
                        {
                            var itemClass = $"chat-item-modern {(_activeChatId == chat.Id ? "chat-item-modern--active" : "")}";

                            <div class="@itemClass"
                                 @onclick="@(() => SelectChat(chat))">
                                <div class="chat-avatar-wrap">
                                    <div class="chat-avatar-modern" style="background:@(chat.AvatarColor ?? "#579DFF")">
                                        @GetChatInitial(chat)
                                    </div>
                                    @if (IsOtherUserOnline(chat))
                                    {
                                        <span class="online-dot"></span>
                                    }
                                </div>

                                <div class="chat-item-main">
                                    <div class="chat-item-topline">
                                        <div class="chat-item-name-modern">@GetChatName(chat)</div>

                                        @if (chat.UnreadCount > 0)
                                        {
                                            <div class="chat-unread-badge-modern">@chat.UnreadCount</div>
                                        }
                                    </div>

                                    <div class="chat-item-bottomline">
                                        @if (chat.LastMessage is not null)
                                        {
                                            <div class="chat-item-preview-modern">@chat.LastMessage</div>
                                        }
                                        else
                                        {
                                            <div class="chat-item-preview-modern chat-item-preview-modern--muted">
                                                @L["chat_no_last_message"]
                                            </div>
                                        }
                                    </div>
                                </div>

                                <div class="chat-item-actions">
                                    <button type="button"
                                            class="chat-delete-btn"
                                            title="@L["chat_delete"]"
                                            @onclick="@(() => ConfirmDeleteChatAsync(chat))"
                                            @onclick:stopPropagation="true">
                                        <MudIcon Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" />
                                    </button>
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudPaper>

            <!-- Main -->
            <MudPaper Class="chats-main-modern" Elevation="0">
                @if (_activeChat is null)
                {
                    <div class="chat-empty-state">
                        <div class="chat-empty-icon-wrap">
                            <MudIcon Icon="@Icons.Material.Filled.Chat" Size="Size.Large" />
                        </div>
                        <MudText Typo="Typo.h6">@L["chat_select"]</MudText>
                        <MudText Typo="Typo.body2" Class="chat-empty-subtitle">
                            @L["chat_empty_hint"]
                        </MudText>
                    </div>
                }
                else
                {
                    <div class="chats-main-header-modern">
                        <div class="chat-header-left">
                            <div class="chat-avatar-wrap">
                                <div class="chat-header-avatar" style="background:@(_activeChat.AvatarColor ?? "#579DFF")">
                                    @GetChatInitial(_activeChat)
                                </div>
                                @if (IsActiveChatPartnerOnline())
                                {
                                    <span class="online-dot online-dot--header"></span>
                                }
                            </div>

                            <div>
                                <MudText Typo="Typo.h6" Class="chat-header-title">
                                    @GetChatName(_activeChat)
                                </MudText>
                                <MudText Typo="Typo.caption" Class="chat-header-subtitle">
                                    @if (IsActiveChatPartnerOnline())
                                    {
                                        <span class="online-status-text">онлайн</span>
                                    }
                                    else
                                    {
                                        @(_activeChat.Members.Count + " " + L["chat_participants"])
                                    }
                                </MudText>
                                @if (_typingUsers.Count > 0)
                                {
                                    <MudText Typo="Typo.caption" Class="chat-typing-status">
                                        @GetTypingText()
                                    </MudText>
                                }
                            </div>
                        </div>

                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                       Color="Color.Error"
                                       Class="chat-header-delete-btn"
                                       OnClick="@(() => ConfirmDeleteChatAsync(_activeChat))" />
                    </div>

                    <div class="messages-area-modern" @ref="_messagesContainer">
                        @if (_loadingMessages)
                        {
                            <div class="chat-loading-state">
                                <MudProgressCircular Indeterminate="true" Size="Size.Medium" Color="Color.Primary" />
                            </div>
                        }
                        else if (_messages.Count == 0)
                        {
                            <div class="chat-loading-state">
                                <MudIcon Icon="@Icons.Material.Filled.MarkChatRead" Size="Size.Large" Style="opacity:.35" />
                                <MudText Typo="Typo.body2" Style="opacity:.65">@L["chat_no_messages"]</MudText>
                            </div>
                        }
                        else
                        {
                            @foreach (var m in _messages)
                            {
                                var bubbleClass = $"message-row-modern {(m.IsOwn ? "message-row-modern--own" : "message-row-modern--other")}";

                                <div class="@bubbleClass">
                                    <div class="message-bubble-modern @(m.IsDeleted ? "message-bubble-modern--deleted" : "")">
                                        @if (!m.IsOwn)
                                        {
                                            <div class="message-sender-modern">@m.SenderName</div>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(m.Text))
                                        {
                                            <div class="message-text-modern @(ShouldCollapseMessage(m) ? "message-text-modern--collapsed" : "")">
                                                @GetDisplayedMessageText(m)
                                            </div>
                                            @if (IsLongMessage(m))
                                            {
                                                <button type="button"
                                                        class="message-expand-btn"
                                                        @onclick="@(() => ToggleMessageExpanded(m.Id))">
                                                    @(IsMessageExpanded(m.Id) ? L["chat_collapse"] : L["chat_expand"])
                                                </button>
                                            }
                                        }

                                        @if (m.Attachments?.Count > 0)
                                        {
                                            <div class="chat-attachment-stack">
                                                @foreach (var attachment in m.Attachments)
                                                {
                                                    <button type="button"
                                                            @onclick="@(() => DownloadAttachmentAsync(attachment))"
                                                            class="chat-attachment-pill">
                                                        <span class="chat-attachment-icon @GetAttachmentAccentClass(attachment)">
                                                            <MudIcon Icon="@GetAttachmentIcon(attachment)" />
                                                        </span>

                                                        <span class="chat-attachment-copy">
                                                            <span class="chat-attachment-name">@attachment.FileName</span>
                                                            <span class="chat-attachment-meta">@FormatBytes(attachment.Size)</span>
                                                        </span>
                                                    </button>
                                                }
                                            </div>
                                        }

                                        <div class="message-footer-modern">
                                            <span class="message-time-modern">
                                                @KyrgyzstanTime.FormatDateTime(m.SentAt)
                                            </span>

                                            @if (m.IsOwn && !m.IsDeleted)
                                            {
                                                <span class="message-read-status-modern" title="@(m.IsReadByOthers ? "Прочитано" : "Отправлено")">
                                                    <MudIcon Icon="@(m.IsReadByOthers ? Icons.Material.Filled.DoneAll : Icons.Material.Filled.Done)"
                                                             Size="Size.Small" />
                                                </span>
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                               Size="Size.Small"
                                                               Class="message-delete-btn-modern"
                                                               OnClick="@(() => DeleteMessage(m.Id))" />
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    <div class="message-input-bar-modern" style="position:relative;">
                        @if (_emojiOpen)
                        {
                            <div class="emoji-picker-panel" @onclick:stopPropagation="true">
                                @foreach (var (label, emojis) in EmojiCategories)
                                {
                                    <div class="emoji-category-label">@label</div>
                                    <div class="emoji-grid">
                                        @foreach (var e in emojis)
                                        {
                                            <button type="button" class="emoji-btn" @onclick="@(() => InsertEmoji(e))">@e</button>
                                        }
                                    </div>
                                }
                            </div>
                        }

                        <MudTextField T="string"
                                      Value="_newMessage"
                                      ValueChanged="OnMessageInputChanged"
                                      Placeholder="@L["chat_placeholder"]"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      AutoGrow="true"
                                      Immediate="true"
                                      Class="chat-msg-input"
                                      Style="flex:1"
                                      OnKeyDown="HandleMessageKeyDown" />

                        @if (_newMessage.Length > ChatMessageWarningLength)
                        {
                            <MudText Typo="Typo.caption"
                                     Class="@($"chat-message-counter {(_newMessage.Length > ChatMessageMaxLength ? "chat-message-counter--error" : "")}")">
                                @_newMessage.Length / @ChatMessageMaxLength
                            </MudText>
                        }

                        <MudIconButton Icon="@Icons.Material.Outlined.EmojiEmotions"
                                       title="@L["chat_emoji"]"
                                       OnClick="@(() => _emojiOpen = !_emojiOpen)"
                                       Color="@(_emojiOpen ? Color.Primary : Color.Default)"
                                       Size="Size.Medium" />

                        <InputFile id="chat-file-upload"
                                   class="file-picker-input"
                                   accept="@FileUploadRules.AcceptAttribute"
                                   OnChange="UploadFilesAsync"
                                   multiple />
                        <label for="chat-file-upload" class="file-picker-trigger file-picker-trigger--chat" title="@L["chat_send_files"]">
                            <MudIcon Icon="@Icons.Material.Filled.AttachFile" />
                        </label>

                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   OnClick="SendMessage"
                                   Disabled="@(string.IsNullOrWhiteSpace(_newMessage) || _newMessage.Length > ChatMessageMaxLength || _sendingMessage)"
                                   Class="send-btn-modern">
                            @L["chat_send"]
                        </MudButton>
                    </div>
                }
            </MudPaper>
        </div>
    </div>
</MudStack>

<MudDialog @bind-Visible="_newChatOpen"
           Options="@(new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true })">
    <TitleContent>
        <MudText Typo="Typo.h6">@L["chat_new"]</MudText>
    </TitleContent>

    <DialogContent>
        <div class="new-chat-dialog-body">
            <MudToggleGroup T="string"
                            @bind-Value="_newChatType"
                            FullWidth="true"
                            Class="mb-4 new-chat-toggle">
                <MudToggleItem Value="@("direct")">@L["chat_type_direct"]</MudToggleItem>
                <MudToggleItem Value="@("group")">@L["chat_type_group"]</MudToggleItem>
            </MudToggleGroup>

            @if (_newChatType == "direct")
            {
                <MudSelect T="string?"
                           @bind-Value="_targetUserId"
                           Label="@L["chat_user"]"
                           Variant="Variant.Outlined"
                           Required="true">
                    @foreach (var u in _users)
                    {
                        <MudSelectItem Value="@u.Id">@u.UserName</MudSelectItem>
                    }
                </MudSelect>
            }
            else
            {
                <MudTextField @bind-Value="_groupName"
                              Label="@L["chat_group_name"]"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              Required="true" />

                <div class="cal-participants-label">
                    <span class="cal-participants-label__text">@L["chat_members"]</span>
                    @if (_users.Count > 0)
                    {
                        var allSelected = _selectedMemberIds.Count() == _users.Count;
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   StartIcon="@(allSelected ? Icons.Material.Filled.RemoveDone : Icons.Material.Filled.DoneAll)"
                                   OnClick="@(() => { _selectedMemberIds = allSelected ? (IEnumerable<string>)[] : _users.Select(u => u.Id).ToList(); })">
                            @(allSelected ? L["cal_deselect_all"] : L["cal_select_all"])
                        </MudButton>
                    }
                </div>
                <MudSelect T="string"
                           @bind-SelectedValues="_selectedMemberIds"
                           Label="@L["chat_members"]"
                           MultiSelection="true"
                           Variant="Variant.Outlined"
                           ToStringFunc="@(id => _users.FirstOrDefault(u => u.Id == id)?.UserName ?? id)">
                    @foreach (var u in _users)
                    {
                        <MudSelectItem Value="@u.Id">@u.UserName</MudSelectItem>
                    }
                </MudSelect>
            }
        </div>
    </DialogContent>

    <DialogActions>
        <MudButton OnClick="@(() => _newChatOpen = false)">
            @L["btn_cancel"]
        </MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateChat">
            @L["btn_create"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int ChatMessageMaxLength = 4000;
    private const int ChatMessageWarningLength = 3600;
    private const int LongMessagePreviewLength = 900;

    // Query param: /chats?chatId=... в†’ auto-open that chat
    [SupplyParameterFromQuery(Name = "chatId")]
    private string? ChatIdParam { get; set; }

    private List<ChatSummaryDto> _chats = [];
    private List<ChatMessageDto> _messages = [];
    private ChatSummaryDto? _activeChat;
    private Guid? _activeChatId;
    private string _search = "";
    private string _newMessage = "";
    private bool _sendingMessage;
    private bool _emojiOpen;
    private bool _loadingMessages;
    private bool _newChatOpen;
    private string _newChatType = "direct";
    private string? _targetUserId;
    private string _groupName = "";
    private IEnumerable<string> _selectedMemberIds = [];
    private List<UserDto> _users = [];
    private ElementReference _messagesContainer;
    private string _currentUserId = "";
    private bool _shouldScrollToBottom;
    private readonly Dictionary<string, string> _typingUsers = [];
    private CancellationTokenSource? _typingStopCts;
    private bool _isTyping;
    private readonly HashSet<Guid> _handledChatNotificationIds = [];
    private readonly HashSet<Guid> _expandedMessages = [];

    private IEnumerable<ChatSummaryDto> FilteredChats => string.IsNullOrWhiteSpace(_search)
        ? _chats
        : _chats.Where(c => GetChatName(c).Contains(_search, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthState.GetAuthenticationStateAsync();
        _currentUserId = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        NotifSvc.OnNotification += OnChatNotificationReceived;
        NotifSvc.OnPresenceChanged += OnPresenceChanged;
        ChatSvc.OnNewMessage += OnNewMessage;
        ChatSvc.OnChatRead += OnChatRead;
        ChatSvc.OnTyping += OnTyping;
        ChatSvc.OnMessageDeleted += OnMessageDeleted;
        _users = await EmployeeSvc.GetAllAsync(excludeAdmins: true);
        _chats = await ChatSvc.GetChatsAsync();

        // Auto-open chat from query param (e.g. clicked a notification)
        if (ChatIdParam is not null && Guid.TryParse(ChatIdParam, out var chatId))
        {
            var chat = _chats.FirstOrDefault(c => c.Id == chatId);
            if (chat is not null)
                await SelectChat(chat);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        // Handle navigation to a different chat while already on ChatsPage
        if (_chats.Count > 0
         && ChatIdParam is not null
         && Guid.TryParse(ChatIdParam, out var chatId)
         && _activeChatId != chatId)
        {
            var chat = _chats.FirstOrDefault(c => c.Id == chatId);
            if (chat is not null)
                await SelectChat(chat);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_shouldScrollToBottom)
        {
            _shouldScrollToBottom = false;
            await JS.InvokeVoidAsync("eval",
                "var c=document.querySelector('.messages-area-modern');if(c)c.scrollTop=c.scrollHeight");
        }

        // Prevent Enter from inserting a newline — must be done in JS before browser default fires
        await JS.InvokeVoidAsync("eval", @"
            (function(){
                var t=document.querySelector('.chat-msg-input textarea');
                if(t&&!t._noEnter){
                    t._noEnter=true;
                    t.addEventListener('keydown',function(e){
                        if(e.key==='Enter'&&!e.shiftKey)e.preventDefault();
                    });
                }
            })()
        ");
    }

    private async Task SelectChat(ChatSummaryDto chat)
    {
        if (_activeChatId.HasValue)
        {
            await NotifyTypingAsync(false);
            await ChatSvc.LeaveChatAsync(_activeChatId.Value);
        }

        _activeChat = chat;
        _activeChatId = chat.Id;
        _loadingMessages = true;
        _typingUsers.Clear();
        StateHasChanged();

        await ChatSvc.ConnectAsync(chat.Id);
        _messages = await ChatSvc.GetMessagesAsync(chat.Id);

        // Reset badge for this chat
        chat = chat with { UnreadCount = 0 };
        var idx = _chats.FindIndex(c => c.Id == chat.Id);
        if (idx >= 0) _chats[idx] = chat;

        _loadingMessages = false;
        _shouldScrollToBottom = true;

        // Mark chat notifications for this chat as read
        await ChatSvc.MarkReadAsync(chat.Id);
        await NotifSvc.MarkChatNotificationsReadAsync(chat.Id);
    }

    // Called by ChatHub only for the currently joined chat
    private void OnNewMessage(NewMessageEvent evt)
    {
        if (evt.ChatId == _activeChatId)
        {
            // Always dedup by ID — handles both normal flow and the race where the
            // SignalR event arrives before the HTTP response from SendMessageAsync.
            if (_messages.Any(m => m.Id == evt.Message.Id)) return;

            // Own message from another tab: mark as own
            var isOwn = evt.Message.SenderId == _currentUserId;
            _messages.Add(isOwn ? evt.Message with { IsOwn = true } : evt.Message);
            _shouldScrollToBottom = true;
            _ = ChatSvc.MarkReadAsync(evt.ChatId);
            _ = InvokeAsync(StateHasChanged);
        }
        else
        {
            // ChatHub won't send this (user isn't in that group), but handle defensively
            UpdateChatBadge(evt.ChatId, evt.Message.Text);
        }
    }

    // Called by NotificationHub for all chat messages, including non-active chats
    private void OnChatNotificationReceived(NotificationDto notif)
    {
        if (notif.NotificationType != NotificationType.Chat) return;
        if (!_handledChatNotificationIds.Add(notif.Id)) return;
        // Keep the dedup set bounded to prevent unbounded memory growth
        if (_handledChatNotificationIds.Count > 500)
            _handledChatNotificationIds.Clear();
        if (notif.RelatedEntityId is null) return;
        if (!Guid.TryParse(notif.RelatedEntityId, out var chatId)) return;
        if (chatId == _activeChatId)
        {
            _ = ChatSvc.MarkReadAsync(chatId);
            _ = NotifSvc.MarkReadAsync(notif.Id);
            return; // already shown via ChatHub
        }

        UpdateChatBadge(chatId, notif.Body);
    }

    private void OnChatRead(ChatReadEvent evt)
    {
        if (evt.ChatId != _activeChatId || evt.UserId == _currentUserId)
            return;

        var changed = false;
        for (var i = 0; i < _messages.Count; i++)
        {
            var message = _messages[i];
            if (message.IsOwn && !message.IsDeleted && !message.IsReadByOthers && message.SentAt <= evt.ReadAt)
            {
                _messages[i] = message with { IsReadByOthers = true };
                changed = true;
            }
        }

        if (changed)
            _ = InvokeAsync(StateHasChanged);
    }

    private void OnTyping(ChatTypingEvent evt)
    {
        if (evt.ChatId != _activeChatId || evt.UserId == _currentUserId)
            return;

        if (evt.IsTyping)
            _typingUsers[evt.UserId] = evt.UserName;
        else
            _typingUsers.Remove(evt.UserId);

        _ = InvokeAsync(StateHasChanged);
    }

    private void OnMessageDeleted(MessageDeletedEvent evt)
    {
        if (evt.ChatId != _activeChatId) return;
        var idx = _messages.FindIndex(m => m.Id == evt.MessageId);
        if (idx >= 0)
            _messages[idx] = _messages[idx] with { IsDeleted = true, Text = L["chat_msg_deleted"], Attachments = [] };
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateChatBadge(Guid chatId, string? lastMessage)
    {
        var idx = _chats.FindIndex(c => c.Id == chatId);
        if (idx >= 0)
        {
            var c = _chats[idx];
            _chats[idx] = c with { LastMessage = lastMessage, UnreadCount = c.UnreadCount + 1 };
            _ = InvokeAsync(StateHasChanged);
            return;
        }

        _ = ReloadChatsAsync();
    }

    private async Task ReloadChatsAsync()
    {
        try
        {
            _chats = await ChatSvc.GetChatsAsync();
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private void InsertEmoji(string emoji)
    {
        _newMessage += emoji;
        _emojiOpen = false;
    }

    private (string Label, string[] Emojis)[] EmojiCategories => [
        (L["chat_emoji_smileys"], ["😀","😁","😂","🤣","😃","😄","😅","😆","😊","😋",
            "😎","😍","🥰","😘","🙂","🤗","🤩","🤔","😐","😑","😶","🙄","😏","😒",
            "😔","😟","😕","🙁","😣","😖","😫","😩","🥺","😢","😭","😤","😠","😡",
            "🤬","🤯","😳","😱","😨","😰","🤭","🤫","🤥","😬","😯","😮","😲","🥱",
            "😴","😵","🤐","🥴","🤢","🤮","🤧","😷","🤒","🤕","🤑","😈","👿","💩",
            "👻","💀","☠️","👽","🤖","😺","😸","😹","😻","😼","😽","🙀","😿","😾"]),
        (L["chat_emoji_gestures"], ["👍","👎","👌","🤌","✌️","🤞","🖖","🤙","💪","🙏",
            "👏","🤝","👋","🤚","🖐️","✋","🖕","🤜","🤛","☝️","👆","👇","👈","👉",
            "🫶","🫂","💅","🤳","🫵","🤲","🖐","🙌","👐"]),
        (L["chat_emoji_hearts"], ["❤️","🧡","💛","💚","💙","💜","🖤","🤍","🤎","💔",
            "❣️","💕","💞","💓","💗","💖","💘","💝","💟","❤️‍🔥","❤️‍🩹","💯","✨","🌟","⭐",
            "🔥","💫","🎉","🎊","🎈","🎁","🎂","🏆","🥇","🎯"]),
