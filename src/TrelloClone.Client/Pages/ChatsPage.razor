    private async Task SendMessage()
    {
        if (_sendingMessage || _activeChatId is null || string.IsNullOrWhiteSpace(_newMessage)) return;
        if (_newMessage.Length > ChatMessageMaxLength)
        {
            Snackbar.Add(string.Format(L["chat_message_too_long"], ChatMessageMaxLength), Severity.Warning);
            return;
        }

        _emojiOpen = false;
        _sendingMessage = true;
        var text = _newMessage;
        _newMessage = "";
        await NotifyTypingAsync(false);
        try
        {
            var msg = await ChatSvc.SendMessageAsync(_activeChatId.Value, text);
            if (msg is not null)
            {
                // Guard: SignalR event may have already added this message if it
                // arrived before the HTTP response (WebSocket is faster than HTTP).
                if (!_messages.Any(m => m.Id == msg.Id))
                    _messages.Add(msg with { IsOwn = true });
                _shouldScrollToBottom = true;
                _ = ChatSvc.MarkReadAsync(_activeChatId.Value);
                StateHasChanged();
            }
        }
        finally
        {
            _sendingMessage = false;
        }
    }

    private async Task HandleMessageKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private Task OnMessageInputChanged(string value)
    {
        // While sending, the browser fires a ValueChanged with "\n" from the Enter key — ignore it
        if (_sendingMessage)
            return Task.CompletedTask;

        _newMessage = value;
        if (_activeChatId.HasValue)
            _ = NotifyTypingWithDelayAsync(!string.IsNullOrWhiteSpace(value));

        return Task.CompletedTask;
    }

    private bool IsLongMessage(ChatMessageDto message)
        => !string.IsNullOrWhiteSpace(message.Text) && message.Text.Length > LongMessagePreviewLength;

    private bool IsMessageExpanded(Guid messageId)
        => _expandedMessages.Contains(messageId);

    private bool ShouldCollapseMessage(ChatMessageDto message)
        => IsLongMessage(message) && !IsMessageExpanded(message.Id);

    private string GetDisplayedMessageText(ChatMessageDto message)
        => ShouldCollapseMessage(message)
            ? message.Text[..LongMessagePreviewLength].TrimEnd() + "..."
            : message.Text;

    private void ToggleMessageExpanded(Guid messageId)
    {
        if (!_expandedMessages.Add(messageId))
            _expandedMessages.Remove(messageId);
    }

    private async Task NotifyTypingWithDelayAsync(bool isTyping)
    {
        await NotifyTypingAsync(isTyping);
        _typingStopCts?.Cancel();

        if (!isTyping)
            return;

        var cts = new CancellationTokenSource();
        _typingStopCts = cts;

        try
        {
            await Task.Delay(1800, cts.Token);
            await NotifyTypingAsync(false);
        }
        catch (TaskCanceledException) { }
    }

    private async Task NotifyTypingAsync(bool isTyping)
    {
        if (_activeChatId is null || _isTyping == isTyping)
            return;

        _isTyping = isTyping;
        try
        {
            await ChatSvc.SendTypingAsync(_activeChatId.Value, isTyping);
        }
        catch { }
    }

    private async Task UploadFilesAsync(InputFileChangeEventArgs args)
    {
        if (_activeChatId is null)
            return;

        var files = args.GetMultipleFiles().ToList();
        if (files.Count == 0)
            return;

        var caption = _newMessage;
        _newMessage = "";
        await NotifyTypingAsync(false);

        try
        {
            var message = await ChatSvc.SendFilesAsync(_activeChatId.Value, files, caption);
            if (message is not null)
            {
                if (!_messages.Any(m => m.Id == message.Id))
                    _messages.Add(message with { IsOwn = true });
                _shouldScrollToBottom = true;
                Snackbar.Add(L["chat_files_sent"], Severity.Success);
                StateHasChanged();
            }
        }
        catch (InvalidOperationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task DeleteMessage(Guid msgId)
    {
        if (_activeChatId is null) return;
        await ChatSvc.DeleteMessageAsync(_activeChatId.Value, msgId);
        var idx = _messages.FindIndex(m => m.Id == msgId);
        if (idx >= 0) _messages[idx] = _messages[idx] with { IsDeleted = true, Text = L["chat_msg_deleted"], Attachments = [] };
    }

    private async Task ConfirmDeleteChatAsync(ChatSummaryDto? chat)
    {
        if (chat is null)
            return;

        var chatName = GetChatName(chat);
        var confirmed = await DialogService.ShowMessageBox(
            L["chat_delete_title"],
            string.Format(L["chat_delete_confirm"], chatName),
            yesText: L["btn_delete"],
            cancelText: L["btn_cancel"]);

        if (confirmed == true)
            await DeleteChatAsync(chat);
    }

    private async Task DeleteChatAsync(ChatSummaryDto chat)
    {
        await ChatSvc.DeleteChatAsync(chat.Id);

        if (_activeChatId == chat.Id)
        {
            await NotifyTypingAsync(false);
            await ChatSvc.LeaveChatAsync(chat.Id);
            _activeChatId = null;
            _activeChat = null;
            _messages = [];
            _typingUsers.Clear();
        }

        _chats.RemoveAll(c => c.Id == chat.Id);
        Snackbar.Add(L["chat_deleted"], Severity.Info);
    }

    private async Task DownloadAttachmentAsync(FileAttachmentDto attachment)
    {
        try
        {
            await FileDownloader.DownloadAsync(attachment.DownloadUrl, attachment.FileName);
        }
        catch
        {
            Snackbar.Add(L["msg_download_failed"], Severity.Error);
        }
    }

    private static string GetAttachmentIcon(FileAttachmentDto attachment)
    {
        var name = attachment.FileName.ToLowerInvariant();
        var contentType = attachment.ContentType?.ToLowerInvariant() ?? string.Empty;

        if (contentType.StartsWith("image/") || name.EndsWith(".png") || name.EndsWith(".jpg") || name.EndsWith(".jpeg") || name.EndsWith(".gif") || name.EndsWith(".webp"))
            return Icons.Material.Filled.Image;
        if (contentType.StartsWith("video/") || name.EndsWith(".mp4") || name.EndsWith(".mov") || name.EndsWith(".avi"))
            return Icons.Material.Filled.Movie;
        if (contentType.StartsWith("audio/") || name.EndsWith(".mp3") || name.EndsWith(".wav") || name.EndsWith(".ogg"))
            return Icons.Material.Filled.Audiotrack;
        if (name.EndsWith(".pdf"))
            return Icons.Material.Filled.PictureAsPdf;
        if (name.EndsWith(".doc") || name.EndsWith(".docx") || name.EndsWith(".txt") || name.EndsWith(".rtf"))
            return Icons.Material.Filled.Description;
        if (name.EndsWith(".xls") || name.EndsWith(".xlsx") || name.EndsWith(".csv"))
            return Icons.Material.Filled.TableChart;
        if (name.EndsWith(".zip") || name.EndsWith(".rar") || name.EndsWith(".7z"))
            return Icons.Material.Filled.FolderZip;

        return Icons.Material.Filled.InsertDriveFile;
    }

    private static string GetAttachmentAccentClass(FileAttachmentDto attachment)
    {
        var name = attachment.FileName.ToLowerInvariant();
        var contentType = attachment.ContentType?.ToLowerInvariant() ?? string.Empty;

        if (contentType.StartsWith("image/") || name.EndsWith(".png") || name.EndsWith(".jpg") || name.EndsWith(".jpeg") || name.EndsWith(".gif") || name.EndsWith(".webp"))
            return "attachment-icon--image";
        if (contentType.StartsWith("video/") || name.EndsWith(".mp4") || name.EndsWith(".mov") || name.EndsWith(".avi"))
            return "attachment-icon--video";
        if (contentType.StartsWith("audio/") || name.EndsWith(".mp3") || name.EndsWith(".wav") || name.EndsWith(".ogg"))
            return "attachment-icon--audio";
        if (name.EndsWith(".pdf"))
            return "attachment-icon--pdf";
        if (name.EndsWith(".doc") || name.EndsWith(".docx") || name.EndsWith(".txt") || name.EndsWith(".rtf"))
            return "attachment-icon--doc";
        if (name.EndsWith(".xls") || name.EndsWith(".xlsx") || name.EndsWith(".csv"))
            return "attachment-icon--sheet";
        if (name.EndsWith(".zip") || name.EndsWith(".rar") || name.EndsWith(".7z"))
            return "attachment-icon--archive";

        return "attachment-icon--default";
    }

    private void OpenNewChat()
    {
        _newChatType = "direct"; _targetUserId = null;
        _groupName = ""; _selectedMemberIds = [];
        _newChatOpen = true;
    }

    private async Task CreateChat()
    {
        Guid chatId;
        if (_newChatType == "direct" && _targetUserId is not null)
            chatId = await ChatSvc.CreateDirectAsync(_targetUserId);
        else if (!string.IsNullOrWhiteSpace(_groupName))
            chatId = await ChatSvc.CreateGroupAsync(_groupName, _selectedMemberIds.ToArray());
        else return;

        _newChatOpen = false;
        _chats = await ChatSvc.GetChatsAsync();
        var chat = _chats.FirstOrDefault(c => c.Id == chatId);
        if (chat is not null) await SelectChat(chat);
    }

    private string GetChatName(ChatSummaryDto c)
    {
        if (c.ChatType != ChatType.Direct) return c.Name ?? L["chat_type_group"];
        return c.Members.FirstOrDefault(m => m.UserId != _currentUserId)?.UserName ?? c.Name ?? L["chat_title"];
    }

    private string GetChatInitial(ChatSummaryDto c)
        => GetChatName(c).Length > 0 ? GetChatName(c)[0].ToString().ToUpper() : "?";

    private string GetCurrentUserId() => _currentUserId;

    private static string FormatBytes(long size)
    {
        string[] units = ["B", "KB", "MB", "GB"];
        double value = size;
        var unitIndex = 0;

        while (value >= 1024 && unitIndex < units.Length - 1)
        {
            value /= 1024;
            unitIndex++;
        }

        return $"{value:0.#} {units[unitIndex]}";
    }

    private void OnPresenceChanged() => _ = InvokeAsync(StateHasChanged);

    private bool IsOtherUserOnline(ChatSummaryDto chat)
    {
        if (chat.ChatType != ChatType.Direct) return false;
        var otherId = chat.Members.FirstOrDefault(m => m.UserId != _currentUserId)?.UserId;
        return otherId is not null && NotifSvc.OnlineUserIds.Contains(otherId);
    }

    private bool IsActiveChatPartnerOnline()
    {
        if (_activeChat?.ChatType != ChatType.Direct) return false;
        var otherId = _activeChat.Members.FirstOrDefault(m => m.UserId != _currentUserId)?.UserId;
        return otherId is not null && NotifSvc.OnlineUserIds.Contains(otherId);
    }

    private string GetTypingText()
    {
        if (_typingUsers.Count == 1)
            return $"{_typingUsers.Values.First()} печатает...";

        return "Несколько участников печатают...";
    }

    public async ValueTask DisposeAsync()
    {
        NotifSvc.OnNotification -= OnChatNotificationReceived;
        NotifSvc.OnPresenceChanged -= OnPresenceChanged;
        ChatSvc.OnNewMessage -= OnNewMessage;
        ChatSvc.OnChatRead -= OnChatRead;
        ChatSvc.OnTyping -= OnTyping;
        ChatSvc.OnMessageDeleted -= OnMessageDeleted;
        _typingStopCts?.Cancel();
        if (_activeChatId.HasValue)
        {
            await NotifyTypingAsync(false);
            await ChatSvc.LeaveChatAsync(_activeChatId.Value);
        }
    }
}
