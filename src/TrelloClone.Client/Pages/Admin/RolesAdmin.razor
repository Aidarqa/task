@page "/admin/roles"
@attribute [Authorize(Policy = TrelloClone.Shared.Models.Permissions.RolesView)]
@inject RoleService RolesSvc
@inject IDialogService Dialog
@inject ISnackbar Snackbar

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
        <MudIcon Icon="@Icons.Material.Filled.AdminPanelSettings" Size="Size.Large" />
        <MudText Typo="Typo.h5">Роли и права</MudText>
        <MudSpacer />
        <AuthorizeView Policy="@TrelloClone.Shared.Models.Permissions.RolesManage" Context="_authM">
            <MudButton Color="Color.Primary" Variant="Variant.Filled"
                       StartIcon="@Icons.Material.Filled.Add"
                       OnClick="OpenCreate">
                Создать роль
            </MudButton>
        </AuthorizeView>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudGrid>
            @foreach (var role in _roles)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-4" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center">
                            <MudIcon Icon="@(role.IsSystem ? Icons.Material.Filled.Shield : Icons.Material.Filled.Group)" />
                            <MudText Typo="Typo.h6">@role.Name</MudText>
                            @if (role.IsSystem)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">системная</MudChip>
                            }
                            <MudSpacer />
                            <AuthorizeView Policy="@TrelloClone.Shared.Models.Permissions.RolesManage" Context="_authR">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="@(() => OpenEdit(role))" />
                                @if (!role.IsSystem)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteAsync(role))" />
                                }
                            </AuthorizeView>
                        </MudStack>

                        @if (!string.IsNullOrWhiteSpace(role.Description))
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">@role.Description</MudText>
                        }

                        <MudDivider Class="my-2" />
                        <MudText Typo="Typo.caption">Прав: @role.Permissions.Count</MudText>
                        <div class="mt-1">
                            @foreach (var permCode in role.Permissions.Take(8))
                            {
                                <MudChip T="string" Size="Size.Small">@permCode</MudChip>
                            }
                            @if (role.Permissions.Count > 8)
                            {
                                <MudChip T="string" Size="Size.Small">+@(role.Permissions.Count - 8)</MudChip>
                            }
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private List<RoleDto> _roles = [];
    private List<PermissionDescriptor> _permissions = [];

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _roles = await RolesSvc.ListAsync();
            _permissions = await RolesSvc.AllPermissionsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Ошибка загрузки: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenCreate()
    {
        var parameters = new DialogParameters
        {
            ["AllPermissions"] = _permissions
        };
        var dlg = await Dialog.ShowAsync<RoleEditDialog>("Создать роль", parameters);
        var res = await dlg.Result;
        if (res is { Canceled: false }) await LoadAsync();
    }

    private async Task OpenEdit(RoleDto role)
    {
        var parameters = new DialogParameters
        {
            ["Role"] = role,
            ["AllPermissions"] = _permissions
        };
        var dlg = await Dialog.ShowAsync<RoleEditDialog>("Редактировать роль", parameters);
        var res = await dlg.Result;
        if (res is { Canceled: false }) await LoadAsync();
    }

    private async Task DeleteAsync(RoleDto role)
    {
        var ok = await Dialog.ShowMessageBox(
            "Удаление роли",
            $"Удалить роль «{role.Name}»? Пользователи потеряют связанные права.",
            yesText: "Удалить", cancelText: "Отмена");
        if (ok != true) return;

        var resp = await RolesSvc.DeleteAsync(role.Id);
        if (resp.IsSuccessStatusCode)
        {
            Snackbar.Add("Роль удалена", Severity.Success);
            await LoadAsync();
        }
        else
        {
            Snackbar.Add($"Ошибка: {await resp.Content.ReadAsStringAsync()}", Severity.Error);
        }
    }
}
