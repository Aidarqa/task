@inject AdminUserService UsersSvc
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3" Style="min-width:380px">
            <MudText Typo="Typo.body2">Новый пароль для <b>@UserName</b></MudText>
            <MudTextField @bind-Value="_password" Label="Пароль (минимум 6 символов)"
                          Required="true" InputType="InputType.Password" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="@(() => MudDialog.Cancel())">Отмена</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled"
                   OnClick="SaveAsync" Disabled="_busy">Сохранить</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public string UserName { get; set; } = "";
    [Parameter] public string UserId { get; set; } = "";

    private string _password = "";
    private bool _busy;

    private async Task SaveAsync()
    {
        _busy = true;
        try
        {
            var resp = await UsersSvc.ResetPasswordAsync(UserId, new AdminResetPasswordRequest(_password));
            if (resp.IsSuccessStatusCode)
            {
                Snackbar.Add("Пароль обновлён", Severity.Success);
                MudDialog.Close(DialogResult.Ok(true));
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"Ошибка: {body}", Severity.Error);
            }
        }
        finally
        {
            _busy = false;
        }
    }
}
