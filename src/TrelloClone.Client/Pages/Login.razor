@page "/login"
@inherits LocalizedBase
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="auth-page">
    <div class="auth-page__bg"></div>

    <MudPaper Class="auth-card-modern" Elevation="0">
        <div class="auth-card-modern__header">
            <div class="auth-brand-badge">
                <MudIcon Icon="@Icons.Material.Filled.TaskAlt" Size="Size.Medium" />
            </div>

            <MudText Typo="Typo.h4" Class="auth-title">
                @L["app_name"]
            </MudText>

            <MudText Typo="Typo.body2" Align="Align.Center" Class="auth-subtitle">
                @L["login_subtitle"]
            </MudText>
        </div>

        <MudStack Spacing="3" Class="auth-form-stack">
            <MudTextField @bind-Value="_email"
                          Label="@L["login_email"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Email"
                          Adornment="Adornment.Start"
                          AdornmentIcon="@Icons.Material.Filled.Email"
                          Class="auth-input" />

            <MudTextField @bind-Value="_password"
                          Label="@L["login_password"]"
                          Variant="Variant.Outlined"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          OnAdornmentClick="() => _showPassword = !_showPassword"
                          Class="auth-input" />

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Size="Size.Large"
                       OnClick="HandleSubmit"
                       Disabled="_loading"
                       Class="auth-submit-btn">
                @if (_loading)
                {
                    <MudProgressCircular Size="Size.Small"
                                         Color="Color.Inherit"
                                         Indeterminate="true"
                                         Class="mr-2" />
                }
                @L["login_btn"]
            </MudButton>
        </MudStack>
    </MudPaper>
</div>

@code {
    private string _email = "";
    private string _password = "";
    private bool _loading;
    private bool _showPassword;

    private async Task HandleSubmit()
    {
        _loading = true;
        try
        {
            var result = await AuthService.LoginAsync(new LoginRequest(_email, _password));

            if (result.Success)
            {
                Snackbar.Add($"{L["login_welcome"]}, {result.UserName}!", Severity.Success);
                Nav.NavigateTo("/");
            }
            else
            {
                Snackbar.Add(result.Error ?? L["login_error"], Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }
}
