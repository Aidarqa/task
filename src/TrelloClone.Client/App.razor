@using Microsoft.AspNetCore.Components.Authorization
@inject TrelloClone.Client.Services.LocalizationService L
@inject ThemeService ThemeSvc
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="@_isDarkMode" Theme="_customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <TrelloClone.Client.Pages.Login />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                        @L["not_found"]
                    </MudAlert>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _isDarkMode;

    protected override void OnInitialized()
    {
        _isDarkMode = ThemeSvc.IsDark;
        ThemeSvc.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("document.body.classList.toggle", "light-theme", !_isDarkMode);
    }

    private void OnThemeChanged()
    {
        _isDarkMode = ThemeSvc.IsDark;
        _ = JS.InvokeVoidAsync("document.body.classList.toggle", "light-theme", !_isDarkMode);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeSvc.Changed -= OnThemeChanged;

    private MudTheme _customTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#579dff",
            Secondary = "#55B3A9",
            Tertiary = "#a78bfa",
            AppbarBackground = "rgba(255, 255, 255, 0.55)",
            Background = "#e8edf5",
            Surface = "rgba(255, 255, 255, 0.55)",
            DrawerBackground = "rgba(255, 255, 255, 0.55)",
            DrawerText = "#1a202c",
            Success = "#34d399",
            Warning = "#fbbf24",
            Error = "#f87168",
            Info = "#60a5fa",
            TextPrimary = "#1a202c",
            TextSecondary = "#4a5568",
            Divider = "rgba(0, 0, 0, 0.08)",
            DividerLight = "rgba(0, 0, 0, 0.04)"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#579dff",
            Secondary = "#55B3A9",
            Tertiary = "#a78bfa",
            AppbarBackground = "rgba(255, 255, 255, 0.06)",
            Background = "#0a0e1a",
            Surface = "rgba(255, 255, 255, 0.06)",
            DrawerBackground = "rgba(255, 255, 255, 0.06)",
            DrawerText = "#e8edf5",
            Success = "#34d399",
            Warning = "#fbbf24",
            Error = "#f87168",
            Info = "#60a5fa",
            TextPrimary = "#e8edf5",
            TextSecondary = "#9aa8bd",
            Divider = "rgba(255, 255, 255, 0.08)",
            DividerLight = "rgba(255, 255, 255, 0.04)"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["'Cera Pro'", "'Inter'", "'Segoe UI'", "sans-serif"],
                FontSize = "0.875rem"
            },
            H4 = new H4Typography { FontWeight = "800" },
            H5 = new H5Typography { FontWeight = "700" },
            H6 = new H6Typography { FontWeight = "700" },
            Button = new ButtonTypography { FontWeight = "700", TextTransform = "none" }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "16px" }
    };
}
