@using Microsoft.AspNetCore.Components.Authorization
@inject TrelloClone.Client.Services.LocalizationService L
@inject ThemeService ThemeSvc
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="@_isDarkMode" Theme="_customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <TrelloClone.Client.Pages.Login />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                        @L["not_found"]
                    </MudAlert>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _isDarkMode;

    protected override void OnInitialized()
    {
        _isDarkMode = ThemeSvc.IsDark;
        ThemeSvc.Changed += OnThemeChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await JS.InvokeVoidAsync("document.body.classList.toggle", "light-theme", !_isDarkMode);
    }

    private void OnThemeChanged()
    {
        _isDarkMode = ThemeSvc.IsDark;
        _ = JS.InvokeVoidAsync("document.body.classList.toggle", "light-theme", !_isDarkMode);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeSvc.Changed -= OnThemeChanged;

    private MudTheme _customTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1E4D8C",
            Secondary = "#0F766E",
            AppbarBackground = "#FFFFFF",
            Background = "#F5F7FB",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            Success = "#198754",
            Warning = "#B7791F",
            Error = "#C2413B",
            Info = "#2563A8",
            TextPrimary = "#172033",
            TextSecondary = "#647084"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#7DA7E8",
            Secondary = "#55B3A9",
            Tertiary = "#9BB7D7",
            AppbarBackground = "#111827",
            Background = "#0F172A",
            Surface = "#182235",
            DrawerBackground = "#111827",
            Success = "#47C083",
            Warning = "#D8A642",
            Error = "#EF6A61",
            Info = "#7DA7E8",
            TextPrimary = "#E5EAF2",
            TextSecondary = "#9AA8BD"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["'Cera Pro'", "'Inter'", "'Segoe UI'", "sans-serif"],
                FontSize = "0.875rem"
            },
            H4 = new H4Typography { FontWeight = "700" },
            H5 = new H5Typography { FontWeight = "700" },
            H6 = new H6Typography { FontWeight = "650" },
            Button = new ButtonTypography { FontWeight = "650", TextTransform = "none" }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" }
    };
}
