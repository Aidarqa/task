@using Microsoft.AspNetCore.Components.Authorization
@inject TrelloClone.Client.Services.LocalizationService L
@inject ThemeService ThemeSvc
@inject IJSRuntime JS
@implements IDisposable

<MudThemeProvider @ref="_themeProvider" @bind-IsDarkMode="@_isDarkMode" Theme="_customTheme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <TrelloClone.Client.Pages.Login />
                </NotAuthorized>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
                    <MudAlert Severity="Severity.Warning" Variant="Variant.Filled">
                        @L["not_found"]
                    </MudAlert>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private MudThemeProvider _themeProvider = null!;
    private bool _isDarkMode = true;

    protected override void OnInitialized()
    {
        _isDarkMode = ThemeSvc.IsDark;
        ThemeSvc.Changed += OnThemeChanged;
    }

    private void OnThemeChanged()
    {
        _isDarkMode = ThemeSvc.IsDark;
        _ = JS.InvokeVoidAsync("document.body.classList.toggle", "light-theme", !_isDarkMode);
        InvokeAsync(StateHasChanged);
    }

    public void Dispose() => ThemeSvc.Changed -= OnThemeChanged;

    private MudTheme _customTheme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0079BF",
            Secondary = "#5BA4CF",
            AppbarBackground = "#026AA7",
            Background = "#F4F5F7",
            Surface = "#FFFFFF",
            DrawerBackground = "#FFFFFF",
            Success = "#61BD4F",
            Warning = "#F2D600",
            Error = "#EB5A46",
            Info = "#00C2E0"
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#579DFF",
            Secondary = "#388BFF",
            Tertiary = "#6CC3E0",
            AppbarBackground = "#1D2125",
            Background = "#1D2125",
            Surface = "#282E33",
            DrawerBackground = "#282E33",
            Success = "#4BCE97",
            Warning = "#F5CD47",
            Error = "#F87168",
            Info = "#6CC3E0",
            TextPrimary = "#B6C2CF",
            TextSecondary = "#8C9BAB"
        },
        Typography = new Typography
        {
            Default = new DefaultTypography
            {
                FontFamily = ["'Segoe UI'", "Roboto", "sans-serif"],
                FontSize = "0.875rem"
            },
            H5 = new H5Typography { FontWeight = "700" },
            H6 = new H6Typography { FontWeight = "600" }
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "8px" }
    };
}
